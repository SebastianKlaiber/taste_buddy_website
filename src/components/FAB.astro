---
// Sticky mobile download bar
import { getGoHref } from '../lib/marketing/app-links';
---
<div id="mobile-download-bar" class="mobile-download-bar fixed bottom-0 left-0 right-0 z-50 md:hidden backdrop-blur-md px-4 py-3 safe-bottom">
  <div class="flex items-center justify-center">
      <a 
        href={getGoHref('homepage-download', 'ios')}
        class="mobile-store-badge-ios flex-shrink-0"
        aria-label="Download on the App Store"
      >
        <img 
          src="/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg"
          alt="Download on the App Store"
          class="h-10"
          width="120"
          height="40"
        />
      </a>
      <a 
        href={getGoHref('homepage-download', 'android')}
        class="mobile-store-badge-android flex-shrink-0"
        aria-label="Get it on Google Play"
      >
        <img 
          src="/images/Google_Play_Badge.png"
          alt="Get it on Google Play"
          class="h-10 w-auto"
          width="270"
          height="80"
        />
      </a>
  </div>
</div>

<style>
  .mobile-download-bar {
    background: color-mix(in srgb, var(--tb-surface) 94%, transparent);
    border-top: 1px solid var(--tb-border-soft);
  }

  .safe-bottom {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
</style>
