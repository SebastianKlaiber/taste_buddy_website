---
import type { FeedSiteRecord, Locale } from '../../lib/marketing/types';
import { buildAlternates } from '../../lib/marketing/app-links';
import Layout from '../../layouts/Layout.astro';
import Main from '../Main.astro';
import DownloadCtas from './DownloadCtas.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: Locale;
  sites: FeedSiteRecord[];
}

const { title, description, slug, locale, sites } = Astro.props;
const pagePath = locale === 'de' ? `/de/feeds/${slug}/` : `/feeds/${slug}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  inLanguage: locale,
  hasPart: sites.map((site) => ({
    '@type': 'WebSite',
    name: site.name,
    url: site.website_url,
  })),
};
---

<Layout title={title} description={description} alternates={buildAlternates(pagePath)}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Main>
    <article class="max-w-6xl mx-auto py-12">
      <header class="mb-12 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <h1 class="mb-4 text-4xl font-bold text-white sm:text-5xl">{title}</h1>
        <p class="max-w-3xl text-lg text-gray-300">{description}</p>
      </header>

      <section class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <DownloadCtas slug="rss-tool" primaryLabel={locale === 'de' ? 'RSS in TasteBuddy nutzen' : 'Use RSS in TasteBuddy'} />
      </section>

      <section class="grid gap-6 md:grid-cols-2">
        {sites.map((site) => (
          <article class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
            <div class="mb-3 flex items-center justify-between gap-4">
              <h2 class="text-2xl font-semibold text-white">{site.name}</h2>
              <span class="rounded-full bg-[#1C2513]/80 px-3 py-1 text-xs uppercase tracking-[0.2em] text-[#8FECA8]">
                {site.country}
              </span>
            </div>
            <p class="mb-4 text-gray-300">{site.recommended_reason}</p>
            <p class="mb-4 text-sm text-gray-400">{site.content_focus}</p>
            <div class="flex flex-wrap gap-2">
              {site.category_tags.map((tag) => (
                <span class="rounded-full border border-[#2A2D24]/30 bg-[#1C2513]/80 px-3 py-1 text-sm text-gray-300">
                  {tag}
                </span>
              ))}
            </div>
            <div class="mt-6 flex flex-wrap gap-3 text-sm">
              <a class="text-[#8FECA8]" href={site.website_url} rel="noopener noreferrer" target="_blank">
                Visit site
              </a>
              <a class="text-[#8FECA8]" href={site.feed_url} rel="noopener noreferrer" target="_blank">
                Open feed
              </a>
            </div>
          </article>
        ))}
      </section>
    </article>
  </Main>
</Layout>
