---
import type { KeywordRecord } from '../../lib/marketing/types';
import Layout from '../../layouts/Layout.astro';
import Main from '../Main.astro';
import DownloadCtas from './DownloadCtas.astro';

interface Props {
  record: KeywordRecord;
}

const { record } = Astro.props;
const readableLinkLabel = (href: string) =>
  href
    .replace(/^\/|\/$/g, '')
    .split('/')
    .pop()
    ?.replace(/-/g, ' ')
    .replace(/\b\w/g, (letter) => letter.toUpperCase()) ?? href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: record.title,
  description: record.description,
  inLanguage: 'en',
  dateModified: record.last_reviewed_at,
  author: {
    '@type': 'Organization',
    name: 'TasteBuddy',
  },
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `What should I look for in a ${record.primary_keyword}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: record.decision_criteria.join(' '),
      },
    },
    {
      '@type': 'Question',
      name: `Who is TasteBuddy best for?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: record.best_for_tastebuddy.join(' '),
      },
    },
  ],
};
---

<Layout title={record.title} description={record.description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  <Main>
    <article class="max-w-5xl mx-auto py-12">
      <header class="mb-12 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <p class="mb-4 text-sm uppercase tracking-[0.2em] text-[#8FECA8]">{record.primary_keyword}</p>
        <h1 class="mb-4 text-4xl font-bold text-white sm:text-5xl">{record.title}</h1>
        <p class="max-w-3xl text-lg text-gray-300">{record.description}</p>
      </header>

      <section class="mb-10 grid gap-6 md:grid-cols-[1.2fr_0.8fr]">
        <div class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
          <h2 class="mb-4 text-2xl font-semibold text-white">How to evaluate the category</h2>
          <p class="mb-6 text-gray-300">{record.hero}</p>
          <ul class="space-y-3 text-gray-300">
            {record.decision_criteria.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[#8FECA8]"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
          <DownloadCtas slug={record.cta_variant} />
        </div>
      </section>

      <section class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <h2 class="mb-4 text-2xl font-semibold text-white">Where TasteBuddy fits best</h2>
        <ul class="space-y-3 text-gray-300">
          {record.best_for_tastebuddy.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-[#00CE31]"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <h2 class="mb-4 text-2xl font-semibold text-white">What the TasteBuddy workflow includes</h2>
        <p class="mb-4 text-gray-300">
          This guide evaluates the category around a practical path from saving a recipe to cooking it. TasteBuddy is designed around that complete workflow, not a discovery feed.
        </p>
        <ul class="space-y-3 text-gray-300">
          {record.claims.map((claim) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="text-[#8FECA8]">✓</span>
              <span>{claim}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <h2 class="mb-4 text-2xl font-semibold text-white">FAQ</h2>
        <div class="space-y-6 text-gray-300">
          <div>
            <h3 class="mb-2 text-lg font-semibold text-white">What should I compare first?</h3>
            <p>{record.decision_criteria[0]}</p>
          </div>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-white">When is TasteBuddy the right choice?</h3>
            <p>{record.best_for_tastebuddy.join(' ')}</p>
          </div>
        </div>
        <p class="mt-6 text-sm text-gray-500">Last reviewed: {record.last_reviewed_at}</p>
      </section>

      <section class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <h2 class="mb-4 text-2xl font-semibold text-white">Keep exploring</h2>
        <ul class="space-y-3 text-gray-300">
          {record.internal_links.map((item) => (
            <li>
              <a class="text-[#8FECA8]" href={item}>
                {readableLinkLabel(item)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </Main>
</Layout>
