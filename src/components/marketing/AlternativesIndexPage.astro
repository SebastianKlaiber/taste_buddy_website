---
import type { Locale } from '../../lib/marketing/types';
import { SITE_URL, buildAlternates, getLocalizedPath } from '../../lib/marketing/app-links';
import { listAlternatives, listComparisons } from '../../lib/marketing/content';
import Layout from '../../layouts/Layout.astro';
import Main from '../Main.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const alternatives = listAlternatives(locale);
const comparisons = listComparisons(locale);
const pagePath = getLocalizedPath(locale, '/alternatives/');

const copy = {
  en: {
    eyebrow: 'recipe app alternatives',
    title: 'Recipe App Alternatives',
    description:
      'Find a replacement for Paprika, ReciMe, Samsung Food, Mela, Recipe Keeper, Pestle, and other recipe apps, with honest notes on where each one fits.',
    readMore: 'See the alternatives',
    comparisons: 'Head-to-head comparisons',
    roundupTitle: 'Not switching from a specific app?',
    roundupText: 'Compare the best apps to save recipes from TikTok, Instagram, food blogs, and screenshots.',
    roundupLink: 'See the best recipe saver apps',
  },
  de: {
    eyebrow: 'rezept app alternativen',
    title: 'Alternativen zu Rezept-Apps',
    description:
      'Ersatz für Paprika, ReciMe, Samsung Food, Mela, Recipe Keeper, Pestle und andere Rezept-Apps, mit ehrlichen Hinweisen, wofür jede App passt.',
    readMore: 'Alternativen ansehen',
    comparisons: 'Direkte Vergleiche',
    roundupTitle: 'Sie wechseln nicht von einer bestimmten App?',
    roundupText: 'Vergleichen Sie die besten Apps, um Rezepte aus TikTok, Instagram, Foodblogs und Screenshots zu speichern.',
    roundupLink: 'Die besten Apps zum Rezepte speichern',
  },
}[locale];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.title,
  description: copy.description,
  inLanguage: locale,
  url: `${SITE_URL}${pagePath}`,
  hasPart: alternatives.map((record) => ({
    '@type': 'Article',
    headline: record.title,
    url: `${SITE_URL}${getLocalizedPath(locale, `/alternatives/${record.slug}/`)}`,
  })),
};
---

<Layout title={copy.title} description={copy.description} alternates={buildAlternates(pagePath)}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Main>
    <div class="max-w-5xl mx-auto py-12">
      <header class="mb-10 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-6 sm:p-8">
        <p class="mb-4 text-sm uppercase tracking-[0.2em] text-[#8FECA8]">{copy.eyebrow}</p>
        <h1 class="mb-4 text-3xl font-bold text-white sm:text-5xl">{copy.title}</h1>
        <p class="max-w-3xl text-lg text-gray-300">{copy.description}</p>
      </header>

      <a
        class="mb-10 block rounded-2xl border border-[#00CE31]/40 bg-[#1C2513]/80 p-6 transition-colors hover:border-[#8FECA8]/60"
        href={getLocalizedPath(locale, '/best/apps-to-save-recipes/')}
      >
        <h2 class="mb-2 text-xl font-semibold text-white">{copy.roundupTitle}</h2>
        <p class="mb-4 text-gray-300">{copy.roundupText}</p>
        <span class="text-sm text-[#8FECA8]">{copy.roundupLink} →</span>
      </a>

      <section class="mb-10 grid gap-6 md:grid-cols-3">
        {alternatives.map((record) => (
          <a
            class="flex flex-col rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6 transition-colors hover:border-[#8FECA8]/40"
            href={getLocalizedPath(locale, `/alternatives/${record.slug}/`)}
          >
            <h2 class="mb-3 text-xl font-semibold text-white">{record.title}</h2>
            <p class="mb-6 flex-1 text-gray-300">{record.description}</p>
            <span class="text-sm text-[#8FECA8]">{copy.readMore} →</span>
          </a>
        ))}
      </section>

      <section class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <h2 class="mb-4 text-2xl font-semibold text-white">{copy.comparisons}</h2>
        <ul class="space-y-3">
          {comparisons.map((record) => (
            <li>
              <a class="text-[#8FECA8] hover:underline" href={getLocalizedPath(locale, `/comparisons/${record.slug}/`)}>
                {record.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Main>
</Layout>
