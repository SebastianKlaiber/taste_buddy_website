---
import { landingCopy } from '../../lib/marketing/landing-copy';
import { getGoHref, getWebAppHref } from '../../lib/marketing/app-links';
import LandingFaq from './LandingFaq.astro';
import LandingBenefits from './LandingBenefits.astro';
import PhoneFrame from './PhoneFrame.astro';
interface Props { locale: 'en' | 'de' }
const { locale } = Astro.props;
const copy = landingCopy[locale];
const screenSuffix = locale === 'de' ? '-de' : '';
const collectionScreen = `/images/landing-recipe-collection${screenSuffix}.webp`;
const detailScreen = `/images/landing-recipe-detail${screenSuffix}.webp`;
---
<div class="landing">
  <header class="landing-header">
    <a class="brand" href={locale === 'de' ? '/de/' : '/'}>TasteBuddy</a>
    <nav class="page-nav" aria-label={locale === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      <a href={locale === 'de' ? '/de/so-funktioniert-es/' : '/how-it-works/'}>{locale === 'de' ? 'So funktioniert’s' : 'How it works'}</a>
      <a href={locale === 'de' ? '/de/ratgeber/' : '/guides/'}>{locale === 'de' ? 'Ratgeber' : 'Guides'}</a>
      <a href={locale === 'de' ? '/de/blog/' : '/en/blog/'}>Blog</a>
    </nav>
    <nav class="languages" aria-label={locale === 'de' ? 'Sprache' : 'Language'}>
      <a href="/" lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a href="/de/" lang="de" aria-current={locale === 'de' ? 'page' : undefined}>DE</a>
    </nav>
  </header>
  <section class="hero" aria-labelledby="landing-title">
    <div class="hero-copy">
      <h1 id="landing-title">{copy.title}</h1>
      <p>{copy.intro}</p>
      <div class="store-links">
        <a class="mobile-store-badge-ios" href={getGoHref('homepage-download', 'ios')} aria-label={locale === 'de' ? 'Im App Store laden' : 'Download on the App Store'}>
          <img src="/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg" alt="App Store" width="144" height="48" />
        </a>
        <a class="mobile-store-badge-android" href={getGoHref('homepage-download', 'android')} aria-label={locale === 'de' ? 'Bei Google Play laden' : 'Get it on Google Play'}>
          <img src="/images/Google_Play_Badge.png" alt="Google Play" width="162" height="48" />
        </a>
      </div>
      <a class="text-link web-link" href={getWebAppHref()}>{copy.web}</a>
    </div>
    <div class="product" role="img" aria-label={copy.screenAlt}>
      <div class="stage-panel"><img src="/images/landing-hero-food.webp" alt="" width="1024" height="1000" loading="eager" decoding="async" /></div>
      <div class="stage-phones">
        <PhoneFrame class="hero-phone collection" src={collectionScreen} loading="eager" />
        <PhoneFrame class="hero-phone recipe" src={detailScreen} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>
  <section class="sources" aria-label={copy.sources}>
    <p>{copy.sources}</p>
    <ul>{copy.sourceList.map(source => <li>{source}</li>)}</ul>
  </section>
  <LandingBenefits locale={locale} />
  <section id="features" class="workflow" aria-labelledby="workflow-title" data-workflow>
    <div class="workflow-visual" aria-hidden="true" data-active="0">
      <PhoneFrame class="workflow-phone" shareCard={copy.shareCard}>
        {copy.steps.map((step, index) => <img class:list={['workflow-screen', index === 0 && 'is-active']} src={step.screen} alt="" width="660" height="1434" loading="lazy" decoding="async" data-workflow-screen />)}
      </PhoneFrame>
    </div>
    <div class="workflow-copy">
      <h2 id="workflow-title">{copy.heading}</h2>
      <ol>{copy.steps.map((step, index) => (
        <li class:list={['workflow-step', index === 0 && 'is-active']} data-workflow-step>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <a class="text-link" href={step.href}>{step.link}</a>
          <PhoneFrame class="step-phone" src={step.screen} alt={step.alt} shareCard={index === 0 ? copy.shareCard : undefined} />
        </li>
      ))}</ol>
    </div>
  </section>
  <LandingFaq locale={locale} />
  <section class="closing">
    <h2>{copy.closing}</h2>
    <p>{copy.closingBody}</p>
    <a class="btn-primary" href={getGoHref('homepage-download')}>{copy.download}</a>
  </section>
  <nav class="guides" aria-label={copy.guides}>
    <h2>{copy.guides}</h2>
    <div>{copy.links.map(([label, href]) => <a class="text-link" href={href}>{label}</a>)}</div>
  </nav>
</div>
<script>
  // Homepage workflow: the phone shows the screen of the hovered, focused or tapped step and
  // cycles through them on its own until the visitor picks one.
  document.querySelectorAll<HTMLElement>('[data-workflow]').forEach((root) => {
    const visual = root.querySelector<HTMLElement>('.workflow-visual');
    const steps = [...root.querySelectorAll<HTMLElement>('[data-workflow-step]')];
    const screens = [...root.querySelectorAll<HTMLElement>('[data-workflow-screen]')];
    let active = 0;
    let picked = false;
    let timer: number | undefined;
    const stepMs = 4500;
    root.style.setProperty('--workflow-step-ms', `${stepMs}ms`);

    const show = (index: number) => {
      active = index;
      steps.forEach((step, i) => step.classList.toggle('is-active', i === index));
      screens.forEach((screen, i) => screen.classList.toggle('is-active', i === index));
      visual?.setAttribute('data-active', String(index));
    };

    steps.forEach((step, index) => {
      const pick = () => { picked = true; window.clearInterval(timer); delete root.dataset.auto; show(index); };
      step.addEventListener('mouseenter', pick);
      step.addEventListener('focusin', pick);
      step.addEventListener('click', pick);
    });

    if (!visual || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(([entry]) => {
      window.clearInterval(timer);
      delete root.dataset.auto;
      // The shared phone is hidden on small screens, where each step shows its own.
      if (entry.isIntersecting && !picked && visual.offsetParent !== null) {
        root.dataset.auto = '';
        timer = window.setInterval(() => show((active + 1) % steps.length), stepMs);
      }
    }, { threshold: 0.5 }).observe(root);
  });
</script>
<style>
  .landing { max-width: 1304px; margin: auto; padding: 0 32px; color: var(--tb-text-strong); }
  .landing-header { display: flex; align-items: center; gap: 40px; padding: 28px 0; }
  .brand { font-size: 24px; font-weight: 600; letter-spacing: -.04em; margin-right: auto; }
  .page-nav { display: flex; gap: 28px; font-size: 15px; }
  .languages { display: flex; gap: 8px; align-items: center; font-size: 14px; }
  .languages a { color: var(--tb-muted); padding: 4px 0; }
  .languages a[aria-current] { color: var(--tb-text-strong); border-bottom: 2px solid currentColor; }
  .hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 48px; padding: 38px 0 72px; }
  h1 { font-size: clamp(44px, 5vw, 72px); line-height: 1.06; letter-spacing: -.055em; font-weight: 600; max-width: 10.5em; text-wrap: balance; }
  .hero-copy > p { margin: 28px 0 32px; font-size: 18px; line-height: 1.7; max-width: 440px; color: var(--tb-muted); }
  .store-links { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; }
  .store-links img { width: auto; height: 48px; }
  .text-link { color: var(--tb-text-strong); text-decoration: underline; text-decoration-color: var(--tb-border); text-underline-offset: 5px; }
  .text-link:hover { text-decoration-color: currentColor; }
  .web-link { display: inline-block; margin-top: 22px; font-size: 14px; }
  .product { position: relative; aspect-ratio: 560 / 600; }
  .stage-panel { position: absolute; inset: 15% 0 0; overflow: hidden; border-radius: 32px; background: #00340E; }
  .stage-panel img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .stage-panel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 52, 14, 0.35), rgba(0, 52, 14, 0) 45%, rgba(0, 52, 14, 0.25)); }
  /* Phones rise above the panel but are cut off by its bottom edge. */
  .stage-phones { position: absolute; inset: 0; overflow: hidden; border-radius: 0 0 32px 32px; }
  .stage-phones :global(.hero-phone) { position: absolute; }
  .stage-phones :global(.collection) { left: 5%; top: 44%; width: 38%; }
  .stage-phones :global(.recipe) { right: 6%; top: 3%; width: 50%; }
  .sources { padding: 32px 0; border-top: 1px solid var(--tb-border); border-bottom: 1px solid var(--tb-border); text-align: center; }
  .sources p { color: var(--tb-muted); font-size: 14px; margin-bottom: 20px; }
  .sources ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px 38px; font-size: 18px; font-weight: 600; }
  .workflow { display: grid; grid-template-columns: .95fr 1fr; gap: 100px; align-items: center; padding: 100px 0; scroll-margin-top: 100px; }
  .workflow-visual { width: 100%; max-width: 440px; justify-self: center; padding: 52px 56px 0; overflow: hidden; border-radius: 32px; background: radial-gradient(120% 80% at 50% 100%, color-mix(in srgb, var(--tb-accent) 20%, transparent), transparent 70%), var(--tb-surface-muted); }
  .workflow-visual :global(.phone) { margin-bottom: -16%; }
  .workflow-screen { position: absolute; inset: 0; opacity: 0; transition: opacity .35s ease; }
  .workflow-screen.is-active { opacity: 1; }
  .workflow-visual :global(.phone-share-card) { transition: opacity .35s ease, transform .35s ease; }
  .workflow-visual:not([data-active="0"]) :global(.phone-share-card) { opacity: 0; transform: translateY(12px); }
  .workflow-step { position: relative; padding-left: 22px; border-left: 3px solid var(--tb-border); cursor: pointer; transition: border-color .2s ease; }
  .workflow-step.is-active { border-left-color: var(--tb-accent); }
  /* While the steps advance on their own, the active step's bar fills up as a countdown. */
  .workflow[data-auto] .workflow-step.is-active { border-left-color: var(--tb-border); }
  .workflow[data-auto] .workflow-step.is-active::before { content: ''; position: absolute; top: 0; left: -3px; width: 3px; height: 100%; background: var(--tb-accent); transform-origin: top; animation: workflow-countdown var(--workflow-step-ms) linear both; }
  @keyframes workflow-countdown { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .workflow-step > * { transition: opacity .2s ease; }
  .workflow-step:not(.is-active) > :is(h3, p) { opacity: .55; }
  .workflow-step :global(.step-phone) { display: none; }
  h2 { font-size: clamp(30px, 3vw, 42px); font-weight: 600; letter-spacing: -.04em; line-height: 1.15; text-wrap: balance; }
  .workflow ol { margin-top: 36px; display: grid; gap: 30px; }
  .workflow h3 { font-size: 21px; line-height: 1.35; font-weight: 600; margin-bottom: 10px; letter-spacing: -.025em; }
  .workflow p { color: var(--tb-muted); line-height: 1.7; margin-bottom: 12px; }
  .workflow a { font-size: 14px; }
  .closing { text-align: center; padding: 70px 24px; background: var(--tb-surface-muted); margin: 64px 0; }
  .closing h2 { max-width: 620px; margin: auto; }
  .closing p { color: var(--tb-muted); margin: 20px 0 28px; }
  .guides { padding: 0 0 64px; }
  .guides h2 { font-size: 20px; margin-bottom: 22px; }
  .guides > div { display: flex; flex-wrap: wrap; gap: 18px 30px; font-size: 14px; }
  a:focus-visible { outline: 3px solid var(--tb-accent); outline-offset: 5px; }
  @media (max-width: 1000px) { .hero { gap: 24px; }  .workflow { gap: 48px; } }
  @media (max-width: 767px) {
    .landing { padding: 0 24px; }
    .landing-header { padding: 24px 0; gap: 16px; }
    .brand { font-size: 20px; }
    .page-nav { display: none; }
    .hero { grid-template-columns: 1fr; padding: 28px 0 40px; gap: 40px; }
    h1 { font-size: clamp(42px, 9vw, 64px); max-width: 11em; }
    .hero-copy > p { font-size: 17px; margin: 22px 0 26px; }
    .product { width: min(100%, 440px); margin: auto; }
    .stage-panel { border-radius: 24px; }
    .stage-phones { border-radius: 0 0 24px 24px; }
    .sources ul { font-size: 15px; gap: 14px 24px; }
    .workflow { grid-template-columns: 1fr; padding: 60px 0; gap: 36px; }
    .workflow-copy { grid-row: 1; }
    .workflow-visual { display: none; }
    .workflow-step { padding-left: 0; border-left: 0; cursor: auto; }
    .workflow-step:not(.is-active) > :is(h3, p) { opacity: 1; }
    .workflow-step :global(.step-phone) { display: block; width: min(62%, 240px); margin: 24px 0 8px 14px; }
    .closing { margin: 40px 0; padding: 44px 22px; }
  }
</style>
