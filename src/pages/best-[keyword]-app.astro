---
import KeywordPage from '../components/marketing/KeywordPage.astro';
import { listKeywords } from '../lib/marketing/content';

export const prerender = true;

export function getStaticPaths() {
  return listKeywords().map((record) => ({
    params: { keyword: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props;
---

<KeywordPage record={record} />
