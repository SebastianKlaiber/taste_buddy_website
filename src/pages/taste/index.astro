---
import Layout from '../../layouts/Layout.astro';
import TastePicker from '../../components/taste/TastePicker.astro';
import { buildAlternates } from '../../lib/marketing/app-links';
import { TASTE_COPY } from '../../lib/taste';

export const prerender = true;

const copy = TASTE_COPY.en;
---

