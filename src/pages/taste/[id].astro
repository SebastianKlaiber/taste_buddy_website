---
// A friend's shared taste: /taste/<token>. Rendered on request (Netlify
// Function) so the Open Graph tags carry the shared image without JavaScript.
import Layout from '../../layouts/Layout.astro';
import TasteTypeHero from '../../components/taste/TasteTypeHero.astro';
import TasteStoreButtons from '../../components/taste/TasteStoreButtons.astro';
import { getSharedTaste } from '../../lib/supabase';
import {
  getPickerPath,
  getTasteType,
  normalizeSharedTaste,
  TASTE_COPY,
  toTasteLocale,
  type SharedTaste,
} from '../../lib/taste';

export const prerender = false;

const token = String(Astro.params.id ?? '').trim();

let result: Awaited<ReturnType<typeof getSharedTaste>>;
let devImageUrl: string | null = null;
if (import.meta.env.DEV && token.startsWith('sample')) {
  // Dev-only sample payloads; this branch and module are dropped from production builds.
  const { DEV_SAMPLE_SHARED_TASTES } = await import('../../lib/taste-dev-sample');
  const sample = DEV_SAMPLE_SHARED_TASTES[token] as { image_url?: string | null } | undefined;
  result = sample ? { status: 'found', body: sample } : { status: 'not_found' };
  devImageUrl = sample?.image_url ?? null;
} else {
  result = await getSharedTaste(token);
}

const shared: SharedTaste | null = result.status === 'found' ? normalizeSharedTaste(result.body) : null;
if (shared && devImageUrl) {
  shared.imageUrl = devImageUrl;
}

const acceptLanguage = Astro.request.headers.get('accept-language') ?? '';
const locale = shared?.locale ?? toTasteLocale(acceptLanguage.split(',')[0]?.trim());
const copy = TASTE_COPY[locale];
const pickerPath = getPickerPath(locale);
const type = shared ? getTasteType(shared.tasteType) : null;
const label = type?.label[locale] ?? '';

const maxCuisineCount = Math.max(1, ...(shared?.topCuisines.map((item) => item.count) ?? []));

const title = shared ? `${copy.sharedTitle(label)} | TasteBuddy` : `${copy.whatsYours} | TasteBuddy`;
const statsLine = shared
  ? [
      shared.recipeCount !== null ? copy.recipes(shared.recipeCount) : '',
      shared.cuisineCount !== null ? copy.cuisines(shared.cuisineCount) : '',
    ].filter(Boolean).join(' · ')
  : '';
const description = type ? [type.description[locale], statsLine].filter(Boolean).join(' · ') : copy.notFoundBody;
const socialImage = shared?.imageUrl && !shared.imageUrl.startsWith('data:') ? shared.imageUrl : undefined;

// A found share renders the same for everyone (its locale comes from the
// payload), so let Netlify's CDN absorb bursts from group chats while keeping
// revocations visible within minutes. Missing shares and errors are not cached.
if (result.status === 'found') {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');
} else {
  Astro.response.status = result.status === 'not_found' ? 404 : 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  // Keep this friendly page instead of Astro swapping in the generic 404 page
  // (Astro's own opt-out header; it is stripped before the response is sent).
  Astro.response.headers.set('X-Astro-Reroute', 'no');
}
---

<Layout
  title={title}
  description={description}
  socialImage={socialImage}
  socialImageAlt={shared ? copy.imageAlt(label) : undefined}
  robots="noindex, follow"
  skipDefaultStructuredData={true}
  lang={locale}
>
  <section class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-12">
    {shared ? (
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
        <div class="mx-auto w-full max-w-xl lg:mx-0">
          <TasteTypeHero
            tasteType={shared.tasteType}
            locale={locale}
            eyebrow={copy.sharedEyebrow}
            headingLevel="h1"
            recipeCount={shared.recipeCount}
            cuisineCount={shared.cuisineCount}
          >
            <a
              href={pickerPath}
              class="taste-cta mt-5"
              data-track-event="taste_cta_clicked"
              data-track-payload={JSON.stringify({ surface: 'shared_page', taste_type: shared.tasteType })}
            >
              {copy.whatsYours} <span aria-hidden="true">→</span>
            </a>

            {shared.topCuisines.length > 0 && (
              <div class="mt-7">
                <h2 class="taste-section-title">{copy.topCuisines}</h2>
                <ul class="mt-3 space-y-3">
                  {shared.topCuisines.map((item) => (
                    <li>
                      <div class="flex items-baseline justify-between gap-3 text-sm font-semibold">
                        <span class="truncate">{item.name}</span>
                        <span class="taste-count">{item.count}</span>
                      </div>
                      <div class="taste-bar mt-1.5" aria-hidden="true">
                        <span style={`width: ${Math.max(6, Math.round((item.count / maxCuisineCount) * 100))}%`}></span>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {shared.topIngredients.length > 0 && (
              <div class="mt-7">
                <h2 class="taste-section-title">{copy.topIngredients}</h2>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {shared.topIngredients.map((item) => (
                    <li class="taste-chip">
                      <span>{item.name}</span>
                      <span class="taste-chip__count">{item.count}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </TasteTypeHero>

          <div class="mt-6 text-center">
            <p class="tb-text-muted text-sm font-semibold">{copy.getApp}</p>
            <TasteStoreButtons surface="shared_page" locale={locale} tasteType={shared.tasteType} class="mt-3" />
          </div>
        </div>

        {shared.imageUrl && (
          <div class="mx-auto w-full max-w-[280px] lg:sticky lg:top-28 lg:max-w-none">
            <img
              src={shared.imageUrl}
              alt={copy.imageAlt(label)}
              width="1080"
              height="1920"
              class="h-auto w-full rounded-2xl shadow-xl"
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </div>
    ) : (
      <div class="mx-auto max-w-xl text-center">
        <div class="tb-panel px-5 py-10 sm:px-10">
          <div class="text-5xl" aria-hidden="true">🍽️</div>
          <h1 class="tb-text-strong mt-4 text-2xl font-bold sm:text-3xl">
            {result.status === 'error' ? copy.unavailableTitle : copy.notFoundTitle}
          </h1>
          <p class="tb-text-muted mt-3">
            {result.status === 'error' ? copy.unavailableBody : copy.notFoundBody}
          </p>
          <a
            href={pickerPath}
            class="btn-primary mt-6"
            data-track-event="taste_cta_clicked"
            data-track-payload={JSON.stringify({ surface: 'shared_page_missing' })}
          >
            {copy.whatsYours}
          </a>
          <TasteStoreButtons surface="shared_page" locale={locale} class="mt-6" />
        </div>
      </div>
    )}
  </section>
</Layout>

<style>
  .taste-cta {
    display: inline-flex;
    min-height: 48px;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--tb-radius-pill);
    background: #00CE31;
    color: #00340E;
    font-size: 1.0625rem;
    font-weight: 800;
    padding: 0.875rem 1.35rem;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .taste-cta:hover {
    transform: translateY(-1px);
    background: #18DF48;
  }

  @media (min-width: 640px) {
    .taste-cta {
      width: auto;
    }
  }

  .taste-section-title {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .taste-count {
    color: #00CE31;
    font-variant-numeric: tabular-nums;
  }

  .taste-bar {
    height: 0.625rem;
    overflow: hidden;
    border-radius: var(--tb-radius-pill);
    background: rgba(255, 255, 255, 0.1);
  }

  .taste-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #00CE31;
  }

  .taste-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    border-radius: var(--tb-radius-pill);
    background: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.375rem 0.5rem 0.375rem 0.875rem;
  }

  .taste-chip span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .taste-chip__count {
    min-width: 1.5rem;
    border-radius: var(--tb-radius-pill);
    background: rgba(0, 206, 49, 0.22);
    color: #8FECA8;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.125rem 0.4rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
</style>
