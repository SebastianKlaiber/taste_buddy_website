---
import Layout from '../../layouts/Layout.astro';
import Main from '../../components/Main.astro';
import DownloadCtas from '../../components/marketing/DownloadCtas.astro';
import { detectRssFeeds } from '../../lib/marketing/tooling';

export const prerender = false;

const query = Astro.url.searchParams.get('url') ?? '';
const result = query ? await detectRssFeeds(query) : null;
---

<Layout title="RSS Feed Detector for Recipe Websites" description="Check whether a recipe website exposes RSS or Atom feeds that TasteBuddy can follow.">
  <Main>
    <section class="max-w-4xl mx-auto py-12">
      <header class="mb-10 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <h1 class="mb-4 text-4xl font-bold text-white">RSS Feed Detector</h1>
        <p class="text-lg text-gray-300">
          Paste a recipe website URL to see whether the page exposes RSS or Atom feeds you could follow in TasteBuddy.
        </p>
      </header>

      <form
        class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6"
        method="GET"
        data-track-event="marketing_tool_submitted"
        data-track-payload={JSON.stringify({ tool_name: 'rss_feed_detector' })}
      >
        <label class="mb-3 block text-sm uppercase tracking-[0.2em] text-[#8FECA8]" for="url">Website URL</label>
        <div class="flex flex-col gap-4 sm:flex-row">
          <input
            class="w-full rounded-xl border border-[#2A2D24]/30 bg-[#0F1108] px-4 py-3 text-white"
            id="url"
            name="url"
            placeholder="https://www.example.com"
            type="url"
            value={query}
          />
          <button class="btn-primary" type="submit">Check feed</button>
        </div>
      </form>

      {result && (
        <section class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
          <h2 class="mb-4 text-2xl font-semibold text-white">{result.ok ? 'Feed detected' : 'No feed detected'}</h2>
          <p class="mb-6 text-gray-300">{result.note}</p>
          {result.detectedFeeds.length > 0 && (
            <ul class="space-y-3 text-gray-300">
              {result.detectedFeeds.map((feed) => (
                <li class="rounded-xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-4">
                  <div class="font-semibold text-white">{feed.title}</div>
                  <a
                    class="text-[#8FECA8]"
                    href={feed.url}
                    rel="noopener noreferrer"
                    target="_blank"
                    data-track-event="marketing_tool_result_clicked"
                    data-track-payload={JSON.stringify({ tool_name: 'rss_feed_detector', result_type: 'feed_url' })}
                  >
                    {feed.url}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}

      <section class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <DownloadCtas slug="rss-tool" primaryLabel="Use RSS in TasteBuddy" secondaryLabel="See RSS subscriptions" />
      </section>
    </section>
  </Main>
</Layout>
