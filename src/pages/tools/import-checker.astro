---
import Layout from '../../layouts/Layout.astro';
import Main from '../../components/Main.astro';
import DownloadCtas from '../../components/marketing/DownloadCtas.astro';
import { detectImportSupport } from '../../lib/marketing/tooling';

export const prerender = false;

const query = Astro.url.searchParams.get('url') ?? '';
const result = query ? detectImportSupport(query) : null;
---

<Layout title="Recipe Import Checker" description="Check whether a URL is a strong fit for TasteBuddy import and what the next step should be.">
  <Main>
    <section class="max-w-4xl mx-auto py-12">
      <header class="mb-10 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <h1 class="mb-4 text-4xl font-bold text-white">Recipe Import Checker</h1>
        <p class="text-lg text-gray-300">
          Paste a recipe, social, or creator URL to see how it fits TasteBuddy's import workflow.
        </p>
      </header>

      <form
        class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6"
        method="GET"
        data-track-event="marketing_tool_submitted"
        data-track-payload={JSON.stringify({ tool_name: 'import_checker' })}
      >
        <label class="mb-3 block text-sm uppercase tracking-[0.2em] text-[#8FECA8]" for="url">Recipe or social URL</label>
        <div class="flex flex-col gap-4 sm:flex-row">
          <input
            class="w-full rounded-xl border border-[#2A2D24]/30 bg-[#0F1108] px-4 py-3 text-white"
            id="url"
            name="url"
            placeholder="https://www.tiktok.com/@creator/video/123"
            type="url"
            value={query}
          />
          <button class="btn-primary" type="submit">Check import</button>
        </div>
      </form>

      {result && (
        <section class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
          <h2 class="mb-4 text-2xl font-semibold text-white">Import status: {result.status}</h2>
          <p class="mb-2 text-gray-300"><strong class="text-white">Source:</strong> {result.source}</p>
          <p class="text-gray-300"><strong class="text-white">Next step:</strong> {result.nextStep}</p>
        </section>
      )}

      <section class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <DownloadCtas slug="save-from-anywhere" primaryLabel="Try the import workflow" secondaryLabel="Browse import pages" />
      </section>
    </section>
  </Main>
</Layout>
