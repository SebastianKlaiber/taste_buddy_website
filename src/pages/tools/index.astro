---
import Layout from '../../layouts/Layout.astro';
import Main from '../../components/Main.astro';

const tools = [
  {
    href: '/tools/rss-feed-detector/',
    title: 'RSS Feed Detector',
    description: 'Check whether a recipe website exposes RSS or Atom feeds you can follow in TasteBuddy.',
  },
  {
    href: '/tools/import-checker/',
    title: 'Import Checker',
    description: 'See whether a TikTok, Pinterest, YouTube, or website URL is a good fit for TasteBuddy import.',
  },
  {
    href: '/tools/link-in-bio-resolver/',
    title: 'Link-in-Bio Resolver',
    description: 'Quickly tell whether a URL is a link-in-bio hub that needs one more click before import.',
  },
];
---

<Layout title="TasteBuddy Tools" description="Small utilities for recipe import, RSS detection, and recipe-source validation.">
  <Main>
    <section class="max-w-5xl mx-auto py-12">
      <header class="mb-12 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <h1 class="mb-4 text-4xl font-bold text-white">TasteBuddy Tools</h1>
        <p class="max-w-3xl text-lg text-gray-300">
          Lightweight utilities built around the same recipe-import and recipe-following workflows the app uses.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-3">
        {tools.map((tool) => (
          <a href={tool.href} class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6 transition hover:border-[#00CE31]/40">
            <h2 class="mb-3 text-2xl font-semibold text-white">{tool.title}</h2>
            <p class="text-gray-300">{tool.description}</p>
          </a>
        ))}
      </div>
    </section>
  </Main>
</Layout>
