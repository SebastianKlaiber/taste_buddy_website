---
import Layout from '../../layouts/Layout.astro';
import Main from '../../components/Main.astro';
import DownloadCtas from '../../components/marketing/DownloadCtas.astro';
import { resolveLinkInBio } from '../../lib/marketing/tooling';

export const prerender = false;

const query = Astro.url.searchParams.get('url') ?? '';
const result = query ? resolveLinkInBio(query) : null;
---

<Layout title="Link-in-Bio Recipe Resolver" description="Check whether a creator URL is a link-in-bio hub before you try to import it into TasteBuddy.">
  <Main>
    <section class="max-w-4xl mx-auto py-12">
      <header class="mb-10 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <h1 class="mb-4 text-4xl font-bold text-white">Link-in-Bio Resolver</h1>
        <p class="text-lg text-gray-300">
          Useful when a creator says “recipe in bio” and you want to know whether the pasted URL is the real recipe page or just a hub.
        </p>
      </header>

      <form
        class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6"
        method="GET"
        data-track-event="marketing_tool_submitted"
        data-track-payload={JSON.stringify({ tool_name: 'link_in_bio_resolver' })}
      >
        <label class="mb-3 block text-sm uppercase tracking-[0.2em] text-[#8FECA8]" for="url">Creator or bio URL</label>
        <div class="flex flex-col gap-4 sm:flex-row">
          <input
            class="w-full rounded-xl border border-[#2A2D24]/30 bg-[#0F1108] px-4 py-3 text-white"
            id="url"
            name="url"
            placeholder="https://linktr.ee/example"
            type="url"
            value={query}
          />
          <button class="btn-primary" type="submit">Check URL</button>
        </div>
      </form>

      {result && (
        <section class="mb-10 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
          <h2 class="mb-4 text-2xl font-semibold text-white">
            {result.isKnownLinkInBio ? 'Known link-in-bio domain' : 'Direct URL or unknown hub'}
          </h2>
          <p class="mb-2 text-gray-300"><strong class="text-white">Host:</strong> {result.host}</p>
          <p class="text-gray-300">{result.recommendation}</p>
        </section>
      )}

      <section class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
        <DownloadCtas slug="save-from-anywhere" primaryLabel="Save the final recipe into TasteBuddy" secondaryLabel="See TikTok import" />
      </section>
    </section>
  </Main>
</Layout>
