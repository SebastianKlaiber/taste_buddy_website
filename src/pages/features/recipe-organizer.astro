---
import Layout from "../../layouts/Layout.astro";
import Main from "../../components/Main.astro";
import DownloadCtas from "../../components/marketing/DownloadCtas.astro";

export const prerender = true;

const title = "Recipe Organizer App for Saved Recipes | TasteBuddy";
const description =
  "Organize recipes from websites, social posts, screenshots, and notes in one searchable cookbook, then use them for meal plans and shopping lists.";

const appStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TasteBuddy",
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS, Android, Web",
  description,
  url: "https://taste-buddy.app/features/recipe-organizer/",
  featureList: [
    "Recipe import from websites and social links",
    "Recipe import from screenshots and notes",
    "Searchable personal recipe collection",
    "Meal planning from saved recipes",
    "Shopping lists from meal plans",
  ],
};

const faq = [
  {
    question: "What is a recipe organizer app?",
    answer:
      "A recipe organizer app keeps recipes from different sources in one searchable collection. TasteBuddy also connects that collection to meal planning, shopping lists, and cooking steps.",
  },
  {
    question: "Can I save recipes from TikTok and websites?",
    answer:
      "Yes. You can share or paste supported social and website links. When a source has too little recipe information, you may need to review or edit the imported result.",
  },
  {
    question: "Can I import handwritten recipes or screenshots?",
    answer:
      "Yes. TasteBuddy can turn photos, screenshots, handwritten cards, and notes into editable recipe cards.",
  },
];

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(appStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <Main>
    <article class="py-12 sm:py-16">
      <header class="mx-auto mb-16 max-w-4xl text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-[#8FECA8]">Recipe organizer app</p>
        <h1 class="mb-6 text-4xl font-bold leading-tight text-white sm:text-5xl">
          Organize the recipes you already saved
        </h1>
        <p class="mx-auto mb-8 max-w-3xl text-xl text-gray-300">
          Bring recipes out of TikTok saves, Instagram, Pinterest, food-blog tabs, screenshots, and handwritten cards. TasteBuddy turns them into a personal cookbook you can search, plan from, shop from, and cook from.
        </p>
        <DownloadCtas slug="organize-recipes" primaryLabel="Start organizing recipes" />
      </header>

      <section class="mb-16 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <h2 class="mb-8 text-center text-3xl font-bold text-white">From scattered saves to one cooking system</h2>
        <ol class="grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
            <span class="mb-4 block text-sm font-bold text-[#8FECA8]">01 · SAVE</span>
            <h3 class="mb-3 text-xl font-semibold text-white">Import the recipe</h3>
            <p class="text-gray-300">Share a supported social or website link, paste a URL, or capture a screenshot, note, or recipe card.</p>
          </li>
          <li class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
            <span class="mb-4 block text-sm font-bold text-[#8FECA8]">02 · FIND</span>
            <h3 class="mb-3 text-xl font-semibold text-white">Keep it searchable</h3>
            <p class="text-gray-300">Store ingredients, steps, photos, servings, and source details in a clean recipe card you can find later.</p>
          </li>
          <li class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6">
            <span class="mb-4 block text-sm font-bold text-[#8FECA8]">03 · COOK</span>
            <h3 class="mb-3 text-xl font-semibold text-white">Turn it into dinner</h3>
            <p class="text-gray-300">Add recipes to a meal plan, move ingredients into a shopping list, and follow clear cooking steps.</p>
          </li>
        </ol>
      </section>

      <section class="mb-16 grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-8">
          <h2 class="mb-5 text-2xl font-bold text-white">What you can import</h2>
          <ul class="space-y-3 text-gray-300">
            <li>Recipe pages and food-blog links</li>
            <li>TikTok, Instagram, Pinterest, YouTube, and Facebook links</li>
            <li>Screenshots, cookbook photos, and handwritten recipe cards</li>
            <li>Notes plus supported Notion and Obsidian workflows</li>
          </ul>
          <p class="mt-5 text-sm text-gray-400">
            Import quality depends on the information available in the original source. Every imported recipe remains editable.
          </p>
        </div>

        <div class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-8">
          <h2 class="mb-5 text-2xl font-bold text-white">What happens after import</h2>
          <ul class="space-y-3 text-gray-300">
            <li>Search one personal collection instead of old saves and browser tabs</li>
            <li>Group recipes into cookbooks that match how you cook</li>
            <li>Plan the week from recipes you already chose</li>
            <li>Create a shopping list from the final meal plan</li>
          </ul>
          <a class="mt-6 inline-block font-semibold text-[#8FECA8]" href="/features/meal-planning/">
            See meal planning in TasteBuddy →
          </a>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="mb-8 text-center text-3xl font-bold text-white">Choose a recipe organizer by workflow, not slogans</h2>
        <div class="overflow-x-auto rounded-2xl border border-[#2A2D24]/30 bg-[#14180F]">
          <table class="w-full min-w-[640px] text-left text-gray-300">
            <thead class="border-b border-[#2A2D24]/50 text-white">
              <tr>
                <th class="p-5">Question to ask</th>
                <th class="p-5">TasteBuddy approach</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-[#2A2D24]/30">
                <td class="p-5 font-medium text-white">Can it handle the places where I save recipes?</td>
                <td class="p-5">Web, social, screenshots, cards, and notes are part of the core import workflow.</td>
              </tr>
              <tr class="border-b border-[#2A2D24]/30">
                <td class="p-5 font-medium text-white">Can I use recipes after saving them?</td>
                <td class="p-5">Saved recipes connect directly to planning, shopping, and cooking.</td>
              </tr>
              <tr>
                <td class="p-5 font-medium text-white">Can I correct an imperfect import?</td>
                <td class="p-5">Imported recipes stay editable, which matters when a source is incomplete.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mb-16 rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-8">
        <h2 class="mb-6 text-3xl font-bold text-white">Recipe organizer FAQ</h2>
        <div class="space-y-8">
          {faq.map((item) => (
            <div>
              <h3 class="mb-2 text-xl font-semibold text-white">{item.question}</h3>
              <p class="max-w-3xl text-gray-300">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="rounded-3xl border border-[#00CE31]/30 bg-[#00CE31]/20 p-8 text-center sm:p-12">
        <h2 class="mb-4 text-3xl font-bold text-white">Cook the recipes you already saved</h2>
        <p class="mx-auto mb-8 max-w-2xl text-lg text-gray-200">
          Start with the recipe you most want to find again. Save it once, then use it for your next plan and shopping list.
        </p>
        <DownloadCtas slug="organize-recipes" primaryLabel="Try TasteBuddy" />
      </section>
    </article>
  </Main>
</Layout>
