---
import Layout from "../../layouts/Layout.astro";
import Main from "../../components/Main.astro";

export const prerender = true;

const description =
  "Plan weekly meals from recipes you already saved, generate shopping lists, and reduce dinner decision fatigue with TasteBuddy.";
---

<Layout title="Meal Planning App for Saved Recipes | TasteBuddy" description={description}>
  <Main>
    <section class="py-12 sm:py-16">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 leading-tight">
          Meal planning from recipes you already saved
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
          TasteBuddy helps you turn saved recipes from TikTok, Instagram, websites, screenshots, and notes into a weekly meal plan, organized shopping list, and clear cooking flow.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4 mb-12">
          <a 
            href="https://apps.apple.com/app/apple-store/id6554007741?pt=127208178&ct=Website&mt=8"
            class="btn-primary text-lg px-8 py-4"
            target="_blank" 
            rel="noopener noreferrer"
          >
            Download Free Meal Planner
          </a>
        </div>
      </div>

      <!-- Key Features Section -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <div class="bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-8 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm text-center">
          <div class="text-4xl mb-4">📚</div>
          <h3 class="text-xl font-semibold text-white mb-3">Plan from your own recipes</h3>
          <p class="text-gray-300">Build the week from recipes you already saved instead of starting with an empty calendar or another generic recipe feed.</p>
        </div>
        
        <div class="bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-8 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm text-center">
          <div class="text-4xl mb-4">🛒</div>
          <h3 class="text-xl font-semibold text-white mb-3">Smart Shopping Lists</h3>
          <p class="text-gray-300">Automatically generate organized shopping lists from your meal plans. The meal planning app groups items by store section for efficient grocery shopping.</p>
        </div>
        
        <div class="bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-8 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm text-center">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-semibold text-white mb-3">Less dinner decision fatigue</h3>
          <p class="text-gray-300">Keep reliable dinner ideas ready so weeknight cooking starts from saved recipes, not another search session.</p>
        </div>
      </div>

      <!-- How It Works Section -->
      <section class="py-12 bg-gradient-to-r from-[#1C2513]/50 to-[#1C2513]/30 rounded-3xl mb-16">
        <h2 class="text-3xl font-bold text-white text-center mb-12">How TasteBuddy's meal planner works</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="bg-[#00CE31]/20 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-white">1</span>
            </div>
            <h3 class="text-xl font-semibold text-white mb-3">Save real recipes</h3>
            <p class="text-gray-300">Capture recipes from social media, websites, screenshots, notes, and handwritten cards into your cookbook.</p>
          </div>
          
          <div class="text-center">
            <div class="bg-[#00CE31]/20 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-white">2</span>
            </div>
            <h3 class="text-xl font-semibold text-white mb-3">Choose what to cook</h3>
            <p class="text-gray-300">Pick dinners from the recipes you already wanted to make and place them into a practical weekly plan.</p>
          </div>
          
          <div class="text-center">
            <div class="bg-[#00CE31]/20 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-white">3</span>
            </div>
            <h3 class="text-xl font-semibold text-white mb-3">Shop and cook</h3>
            <p class="text-gray-300">Turn planned recipes into a shopping list, then open the recipe steps when it is time to cook.</p>
          </div>
        </div>
      </section>

      <!-- Benefits Section -->
      <section class="py-12">
        <h2 class="text-3xl font-bold text-white text-center mb-12">Why choose TasteBuddy's meal planner?</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-[#00CE31]/20 rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[#00CE31] font-bold">✓</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Use saved recipes instead of saving more</h3>
                <p class="text-gray-300">Plan from the recipes already in your collection so your TikTok saves, bookmarks, and screenshots become actual dinners.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-[#00CE31]/20 rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[#00CE31] font-bold">✓</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Shop with a clearer list</h3>
                <p class="text-gray-300">Turn planned meals into ingredients before you go to the store, instead of rebuilding every grocery list from memory.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-[#00CE31]/20 rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[#00CE31] font-bold">✓</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Make healthier saved recipes easier to use</h3>
                <p class="text-gray-300">If you save healthy recipe ideas all week, TasteBuddy gives them a place in your plan instead of leaving them buried.</p>
              </div>
            </div>
          </div>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-[#00CE31]/20 rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[#00CE31] font-bold">✓</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Plan before the grocery run</h3>
                <p class="text-gray-300">A simple plan helps you buy around the recipes you intend to cook, not around vague dinner ideas.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-[#00CE31]/20 rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[#00CE31] font-bold">✓</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Flexible by design</h3>
                <p class="text-gray-300">Use TasteBuddy for a full week, three dinners, or just the next recipe you want to cook. It does not force rigid meal prep.</p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="bg-[#00CE31]/20 rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">
                <span class="text-[#00CE31] font-bold">✓</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white mb-2">Works with shared cooking routines</h3>
                <p class="text-gray-300">Keep recipes, plans, and shopping lists close to the same workflow when cooking for yourself, a partner, or a household.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="py-12">
        <div class="bg-gradient-to-r from-[#00CE31]/40 to-[#00CE31]/30 rounded-3xl p-8 sm:p-12 text-center backdrop-blur-sm border border-[#00CE31]/30">
          <h2 class="text-3xl font-bold text-white mb-4">Start planning from saved recipes</h2>
          <p class="text-xl text-gray-200 mb-8 max-w-2xl mx-auto">Turn recipe saves into a practical weekly plan and shopping list.</p>
          
          <div class="flex flex-wrap justify-center gap-6">
            <a 
              href="https://apps.apple.com/app/apple-store/id6554007741?pt=127208178&ct=Website&mt=8"
              class="btn-primary text-lg px-8 py-4"
              target="_blank" 
              rel="noopener noreferrer"
            >
              Download Meal Planner App
            </a>
            <a 
              href="https://play.google.com/store/apps/details?id=app.tastebuddy"
              class="btn-secondary text-lg px-8 py-4"
              target="_blank" 
              rel="noopener noreferrer"
            >
              Get on Google Play
            </a>
          </div>
        </div>
      </section>
    </section>
  </Main>
</Layout>
