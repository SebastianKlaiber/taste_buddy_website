---
import Layout from "../../layouts/Layout.astro";
import Main from "../../components/Main.astro";

const description =
  "Explore TasteBuddy features for recipe organization, meal planning, and RSS recipe subscriptions.";

const features = [
  {
    href: "/features/recipe-organizer/",
    title: "Recipe Organizer",
    description: "Save recipes from websites, social posts, screenshots, and notes in one searchable cookbook.",
  },
  {
    href: "/features/meal-planning/",
    title: "Meal Planning",
    description: "Plan dinners from recipes you already saved and keep weekly cooking decisions manageable.",
  },
  {
    href: "/features/rss-recipe-subscriptions/",
    title: "RSS Recipe Subscriptions",
    description: "Follow recipe websites and food blogs, then import new recipes into TasteBuddy.",
  },
];
---

<Layout title="TasteBuddy Features" description={description}>
  <Main>
    <section class="mx-auto max-w-5xl py-12 sm:py-16 lg:py-20">
      <header class="mb-12 rounded-3xl border border-[#2A2D24]/30 bg-[#1C2513]/80 p-8">
        <h1 class="mb-4 text-4xl font-bold text-white sm:text-5xl">TasteBuddy Features</h1>
        <p class="max-w-3xl text-lg text-gray-300">{description}</p>
      </header>

      <div class="grid gap-6 md:grid-cols-3">
        {features.map((feature) => (
          <a
            class="rounded-2xl border border-[#2A2D24]/30 bg-[#14180F] p-6 transition hover:border-[#00CE31]/40"
            href={feature.href}
          >
            <h2 class="mb-3 text-2xl font-semibold text-white">{feature.title}</h2>
            <p class="text-gray-300">{feature.description}</p>
          </a>
        ))}
      </div>
    </section>
  </Main>
</Layout>
