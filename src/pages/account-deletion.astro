---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const description =
  "Delete your TasteBuddy account and associated app data in the app, or request deletion from TasteBuddy support.";

const deletionEmail =
  "mailto:support@taste-buddy.app?subject=TasteBuddy%20account%20and%20data%20deletion%20request&body=Please%20delete%20the%20TasteBuddy%20account%20associated%20with%20this%20email%20address.%0A%0AI%20understand%20that%20account%20deletion%20is%20permanent.";
---

<Layout title="Account and Data Deletion | TasteBuddy" description={description}>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
    <header class="mx-auto max-w-3xl text-center">
      <p class="tb-accent text-sm font-semibold uppercase tracking-[0.18em]">Privacy controls</p>
      <h1 class="tb-text-strong mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
        Delete your TasteBuddy account and data
      </h1>
      <p class="tb-text-muted mt-6 text-lg leading-8">
        You can permanently delete your account from TasteBuddy. If you cannot access the app, you can send us a deletion request instead.
      </p>
    </header>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <section class="tb-card p-6 sm:p-8" aria-labelledby="delete-in-app">
        <p class="tb-accent text-sm font-semibold">Fastest option</p>
        <h2 id="delete-in-app" class="tb-text-strong mt-2 text-2xl font-semibold">Delete in the app</h2>
        <ol class="tb-text-muted mt-6 space-y-4">
          <li class="flex gap-3">
            <span class="tb-step-badge flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold">1</span>
            <span>Open TasteBuddy and sign in to the account you want to delete.</span>
          </li>
          <li class="flex gap-3">
            <span class="tb-step-badge flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold">2</span>
            <span>Open <strong class="tb-text-strong font-semibold">Settings</strong>, then choose <strong class="tb-text-strong font-semibold">E-Mail &amp; Password</strong>.</span>
          </li>
          <li class="flex gap-3">
            <span class="tb-step-badge flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold">3</span>
            <span>Tap <strong class="tb-text-strong font-semibold">Delete Account</strong> and confirm <strong class="tb-text-strong font-semibold">Delete</strong>.</span>
          </li>
        </ol>
      </section>

      <section class="tb-card p-6 sm:p-8" aria-labelledby="request-by-email">
        <p class="tb-accent text-sm font-semibold">Cannot access TasteBuddy?</p>
        <h2 id="request-by-email" class="tb-text-strong mt-2 text-2xl font-semibold">Request deletion by email</h2>
        <p class="tb-text-muted mt-6 leading-7">
          Email us from the address connected to your TasteBuddy account so we can verify that the request is yours. Include the account email address, but never send your password or payment details.
        </p>
        <a class="btn-primary mt-6 inline-flex" href={deletionEmail}>
          Email a deletion request
        </a>
        <p class="tb-text-subtle mt-4 text-sm">
          Support: <a class="tb-link" href="mailto:support@taste-buddy.app">support@taste-buddy.app</a>
        </p>
      </section>
    </div>

    <section class="tb-panel-muted mt-6 p-6 sm:p-8" aria-labelledby="deletion-details">
      <h2 id="deletion-details" class="tb-text-strong text-2xl font-semibold">What deletion covers</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="tb-text-strong font-semibold">Deleted</h3>
          <p class="tb-text-muted mt-2 leading-7">
            Your TasteBuddy sign-in account and the application data owned by it, including your profile and saved recipes, are permanently deleted.
          </p>
        </div>
        <div>
          <h3 class="tb-text-strong font-semibold">May be retained</h3>
          <p class="tb-text-muted mt-2 leading-7">
            Information may be retained where processing is required by law or to establish, exercise, or defend legal claims. Deletion-request correspondence is handled under our privacy policy.
          </p>
        </div>
      </div>
      <p class="tb-text-muted mt-6 border-t pt-6 leading-7 tb-divider">
        Deleting your TasteBuddy account does not cancel a paid subscription. Subscription cancellations are handled by the app store or payment provider where you purchased it.
      </p>
    </section>

    <p class="tb-text-muted mt-8 text-center text-sm">
      For more detail about your privacy rights and how TasteBuddy handles personal data, read our <a class="tb-link" href="/privacy/">Privacy Policy</a>.
    </p>
  </section>
</Layout>
