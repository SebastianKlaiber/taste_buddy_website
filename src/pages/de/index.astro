---
import Layout from "../../layouts/Layout.astro";
import LandingPage from "../../components/marketing/LandingPage.astro";
import { getLandingPageSchema } from "../../lib/marketing/landing-seo";
export const prerender = true;
const title = "Rezept-App: Rezepte speichern & planen | TasteBuddy";
const description = "Speichere Rezepte aus TikTok, Instagram, Websites, Screenshots und Notizen. TasteBuddy macht daraus ein Kochbuch, einen Wochenplan und eine Einkaufsliste.";
---
<Layout title={title} description={description} landingPage>
  <LandingPage locale="de" />
  <script type="application/ld+json" set:html={JSON.stringify(getLandingPageSchema("de", description))} />
</Layout>
