---
import Layout from "../../../layouts/Layout.astro";

const recipe = {
  name: "Chili sin Carne",
  description: "Ein herzhaftes und geschmackvolles veganes Chili mit gemischten Bohnen und Gemüse",
  prepTime: "PT15M",
  cookTime: "PT30M",
  totalTime: "PT45M",
  servings: 4,
  difficulty: "Einfach",
  ingredients: [
    "1 EL Olivenöl",
    "1 große Zwiebel, gehackt",
    "2 Knoblauchzehen, fein gehackt",
    "1 rote Paprika, gewürfelt",
    "1 Zucchini, gewürfelt",
    "1 Dose (400g) gehackte Tomaten",
    "1 Dose (400g) Kidneybohnen, abgetropft",
    "1 Dose (400g) schwarze Bohnen, abgetropft",
    "2 EL Tomatenmark",
    "1 TL gemahlener Kreuzkümmel",
    "1 TL geräuchertes Paprikapulver",
    "1 TL Chilipulver (nach Geschmack)",
    "Salz und Pfeffer nach Geschmack",
    "Frischer Koriander (optional, zum Garnieren)"
  ],
  instructions: [
    "Das Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen. Zwiebel und Knoblauch hinzufügen und anbraten, bis sie weich sind.",
    "Paprika und Zucchini hinzufügen und 5 Minuten kochen.",
    "Kreuzkümmel, Paprikapulver, Chilipulver, Salz und Pfeffer einrühren.",
    "Tomatenmark, gehackte Tomaten, Kidneybohnen und schwarze Bohnen hinzufügen. Gut vermischen.",
    "Unbedeckt 20-30 Minuten köcheln lassen, dabei gelegentlich umrühren.",
    "Nach Bedarf nachwürzen. Heiß servieren, optional mit frischem Koriander garnieren."
  ]
};
const structuredData = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": recipe.name,
  "description": recipe.description,
  "prepTime": recipe.prepTime,
  "cookTime": recipe.cookTime,
  "totalTime": recipe.totalTime,
  "recipeYield": recipe.servings,
  "recipeCategory": "Hauptgericht",
  "recipeCuisine": "Mexikanisch",
  "keywords": "chili sin carne, vegetarisches chili, veganes chili, bohnen chili, scharf vegetarisch, fleischfreies chili",
  "suitableForDiet": ["VegetarianDiet", "VeganDiet"],
  "inLanguage": "de",
  "author": {
    "@type": "Organization",
    "name": "TasteBuddy",
    "url": "https://taste-buddy.app"
  },
  "publisher": {
    "@type": "Organization",
    "name": "TasteBuddy",
    "url": "https://taste-buddy.app"
  },
  "datePublished": "2025-01-09",
  "recipeIngredient": recipe.ingredients,
  "recipeInstructions": recipe.instructions.map((instruction, index) => ({
    "@type": "HowToStep",
    "position": index + 1,
    "text": instruction
  })),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": "47",
    "bestRating": "5",
    "worstRating": "1"
  },
  "nutrition": {
    "@type": "NutritionInformation",
    "calories": "290 Kalorien",
    "servingSize": "1 Portion"
  },
  "image": {
    "@type": "ImageObject",
    "url": "https://taste-buddy.app/images/recipes/chili-sin-carne.png",
    "width": 1200,
    "height": 800
  }
};

const title = `${recipe.name} Rezept | TasteBuddy`;
const description = `Lernen Sie, wie man köstliches ${recipe.name} mit unserer Schritt-für-Schritt-Anleitung zubereitet. ${recipe.description}. Fertig in ${recipe.totalTime.replace('PT', '').replace('M', ' Minuten')}.`;
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <article class="max-w-4xl mx-auto">
    <div class="aspect-video max-w-2xl mx-auto mb-8 rounded-2xl overflow-hidden bg-[#2A2D24]">
      <div class="w-full h-full flex items-center justify-center text-6xl">
        🌱
      </div>
    </div>
    
    <header class="text-center mb-8">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">{recipe.name}</h1>
      <p class="text-xl text-gray-300 mb-6">{recipe.description}</p>
      
      <div class="flex flex-wrap justify-center gap-4 text-sm">
        <span class="bg-[#1C2513] px-3 py-1 rounded-full border border-[#2A2D24]">
          🕒 {recipe.totalTime.replace('PT', '').replace('M', ' Min')}
        </span>
        <span class="bg-[#1C2513] px-3 py-1 rounded-full border border-[#2A2D24]">
          👥 {recipe.servings} Portionen
        </span>
        <span class="bg-[#1C2513] px-3 py-1 rounded-full border border-[#2A2D24]">
          📊 {recipe.difficulty}
        </span>
        <span class="bg-[#1C2513] px-3 py-1 rounded-full border border-[#2A2D24]">
          🌱 Vegan
        </span>
      </div>
    </header>

    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <section class="bg-[#1C2513]/80 rounded-2xl p-6 border border-[#2A2D24]/30">
        <h2 class="text-2xl font-semibold text-white mb-4">Zutaten</h2>
        <ul class="space-y-2">
          {recipe.ingredients.map((ingredient) => (
            <li class="flex items-start gap-2 text-gray-300">
              <span class="text-[#00CE31] mt-1">•</span>
              <span>{ingredient}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="bg-[#1C2513]/80 rounded-2xl p-6 border border-[#2A2D24]/30">
        <h2 class="text-2xl font-semibold text-white mb-4">Zubereitung</h2>
        <ol class="space-y-4">
          {recipe.instructions.map((instruction, index) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 bg-[#00CE31] text-black rounded-full flex items-center justify-center font-semibold text-sm">
                {index + 1}
              </span>
              <span class="text-gray-300 leading-relaxed">{instruction}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <section class="bg-[#1C2513]/80 rounded-2xl p-6 border border-[#2A2D24]/30 mb-8">
      <h2 class="text-2xl font-semibold text-white mb-4">Tipps & Hinweise</h2>
      <div class="text-gray-300 space-y-2">
        <p>• Fügen Sie anderes Gemüse wie Mais, Pilze oder Süßkartoffeln für extra Nährstoffe und Geschmack hinzu.</p>
        <p>• Für zusätzliches Protein können Sie zerbröckelten Tofu oder pflanzlichen Fleischersatz hinzufügen.</p>
        <p>• Dieses vegane Chili ist von Natur aus reich an Ballaststoffen und pflanzlichem Protein aus den Bohnen.</p>
        <p>• Servieren Sie mit Avocado, Limette und frischen Kräutern für einen frischen Twist.</p>
        <p>• Reste können als Füllung für Burritos oder über Ofenkartoffeln verwendet werden.</p>
      </div>
    </section>

    <div class="text-center">
      <a href="/de/recipes/" class="btn-secondary inline-block">
        ← Zurück zu allen Rezepten
      </a>
    </div>
  </article>
</Layout>

<style>
  .btn-secondary {
    @apply bg-[#1C2513] hover:bg-[#2A2D24] border border-[#2A2D24] text-white font-medium py-3 px-6 rounded-lg transition-all duration-300;
  }
</style> 