---
import Layout from "../layouts/Layout.astro";
import LandingPage from "../components/marketing/LandingPage.astro";
import { getLandingPageSchema } from "../lib/marketing/landing-seo";
export const prerender = true;
const title = "Recipe Organizer App: Save & Plan Recipes | TasteBuddy";
const description = "Save recipes from TikTok, Instagram, websites, screenshots, and notes. TasteBuddy turns saved recipes into a searchable cookbook, meal plan, and shopping list.";
---
<Layout title={title} description={description} landingPage>
  <LandingPage locale="en" />
  <script type="application/ld+json" set:html={JSON.stringify(getLandingPageSchema("en", description))} />
</Layout>
