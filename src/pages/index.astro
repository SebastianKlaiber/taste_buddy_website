---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import MobileWeb2AppFlow from "../components/MobileWeb2AppFlow.astro";
import { getGoHref, getWebAppHref } from "../lib/marketing/app-links";

export const prerender = true;

const { pathname } = Astro.url;
const isHomePage = pathname === "/" || pathname === "/de/";
const enPath = isHomePage ? "/" : pathname.replace("/de/", "/en/");
const dePath = isHomePage ? "/de/" : pathname.replace("/en/", "/de/");
const pageTitle = "Recipe Organizer for Saved Recipes | TasteBuddy";
const pageDescription =
  "Save recipes from TikTok, Instagram, websites, screenshots, and notes. TasteBuddy turns saved recipes into a searchable cookbook, meal plan, and shopping list.";

// MobileApplication structured data
const mobileAppStructuredData = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "TasteBuddy - Recipe Organizer & Meal Planner",
  url: "https://taste-buddy.app/",
  operatingSystem: "iOS, Android",
  applicationCategory: "LifestyleApplication",
  applicationSubCategory: "Food & Drink",
  keywords:
    "recipe organizer app, recipe saver app, meal planning app, digital cookbook, shopping list app, save recipes from TikTok, save recipes from Instagram",
  featureList: [
    "Save recipes from websites and social media",
    "Import recipes from screenshots, handwritten cards, and notes",
    "Organize recipes into a searchable personal cookbook",
    "Create meal plans from saved recipes",
    "Generate shopping lists from meal plans",
    "Cook from clean step-by-step recipe views"
  ],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock"
  },
  author: {
    "@type": "Organization",
    name: "TasteBuddy",
    url: "https://taste-buddy.app"
  },
  screenshot: [
    "https://taste-buddy.app/images/tastebuddy-save-recipes.webp",
    "https://taste-buddy.app/images/tastebuddy-recipe-details.webp",
    "https://taste-buddy.app/images/tastebuddy-find-recipes.webp",
    "https://taste-buddy.app/images/tastebuddy-cooking-steps.webp",
    "https://taste-buddy.app/images/tastebuddy-meal-planning.webp"
  ],
  description: pageDescription,
  downloadUrl: [
    "https://apps.apple.com/app/apple-store/id6554007741?pt=127208178&ct=Website&mt=8",
    "https://play.google.com/store/apps/details?id=app.tastebuddy"
  ]
};

// FAQ structured data
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is TasteBuddy?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "TasteBuddy is a recipe organizer and meal planning app for people who save recipes from TikTok, Instagram, websites, screenshots, handwritten cards, and notes. It turns those saved recipes into a searchable cookbook, meal plan, shopping list, and clean cooking view."
      }
    },
    {
      "@type": "Question",
      name: "Can I save recipes from TikTok and Instagram?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. You can share a TikTok, Instagram, Pinterest, YouTube, Facebook, or website recipe to TasteBuddy, or paste the link, and TasteBuddy extracts the ingredients, steps, and photos into a clean recipe card."
      }
    },
    {
      "@type": "Question",
      name: "How does TasteBuddy help me cook recipes I already saved?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "TasteBuddy keeps saved recipes searchable, then lets you plan meals from them, send ingredients to a shopping list, and cook from step-by-step instructions instead of digging through old saves again."
      }
    },
    {
      "@type": "Question",
      name: "Does TasteBuddy make shopping lists from recipes?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Recipes added to a meal plan can become a shopping list, so saved recipe ideas turn into ingredients you can actually buy and cook."
      }
    },
    {
      "@type": "Question",
      name: "Is TasteBuddy a meal prep app?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "TasteBuddy is not built around rigid meal prep. It is a flexible recipe organizer for people who save recipes all week and want an easier way to choose, shop for, and cook them."
      }
    }
  ]
};
---
<Layout
  title={pageTitle}
  description={pageDescription}
  hideMobileChrome
>
  <MobileWeb2AppFlow locale="en" />
  <div class="hidden md:block">
  <Main>
    <!-- Language Switcher -->
    <div class="absolute top-6 right-6 z-10">
      <div class="tb-pill flex gap-3 p-2">
        <a href={enPath} class={`px-3 py-1 rounded-full text-sm font-medium transition-colors ${pathname.includes('/de/') ? 'tb-text-muted' : 'tb-pill-active'}`}>
          EN
        </a>
        <a href={dePath} class={`px-3 py-1 rounded-full text-sm font-medium transition-colors ${pathname.includes('/de/') ? 'tb-pill-active' : 'tb-text-muted'}`}>
          DE
        </a>
      </div>
    </div>
    
    <section class="relative overflow-hidden py-12 sm:py-16 lg:py-20">
      <!-- Hero -->
      <!-- Hero -->
      <div class="max-w-5xl mx-auto text-center mb-16 sm:mb-24 px-4">
        <h1 class="tb-text-strong text-5xl sm:text-6xl lg:text-7xl font-extrabold mb-8 leading-tight tracking-tight">
          The recipe organizer <br class="hidden sm:block" />
          <span class="tb-accent">for recipes you actually cook</span>
        </h1>

        <p class="tb-text-muted text-xl sm:text-2xl mb-10 max-w-3xl mx-auto leading-relaxed font-light">
          Save recipes from TikTok, Instagram, Pinterest, YouTube, websites, screenshots, and notes. TasteBuddy turns them into clean recipes you can find, plan, shop for, and cook.
        </p>

        <p class="tb-panel-muted mx-auto mb-10 max-w-3xl px-5 py-4 text-base leading-relaxed tb-text-muted">
          TasteBuddy is a recipe organizer, recipe saver, meal planning app, and shopping list app in one. It is built for home cooks with recipes scattered across social saves, browser tabs, screenshots, bookmarks, handwritten cards, and food blogs.
        </p>

        <div class="hidden md:flex flex-wrap justify-center gap-4 mb-8">
          <a href={getWebAppHref()} class="btn-primary text-base sm:text-lg">
            Open Web App
          </a>
          <a href={getGoHref('homepage-download')} class="btn-secondary text-base sm:text-lg">
            Download App
          </a>
        </div>

        <!-- Store badges above the fold -->
        <div class="flex flex-wrap justify-center gap-5 items-center opacity-90 hover:opacity-100 transition-opacity">
          <a 
            href={getGoHref('homepage-download', 'ios')}
            aria-label="Download on the App Store"
            class="mobile-store-badge-ios transform transition-transform duration-300 hover:scale-105 hover:shadow-lg rounded-lg"
          >
            <img
              src="/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg"
              alt="Download on the App Store"
              class="h-12 sm:h-14 w-auto object-contain"
              width="120"
              height="40"
              fetchpriority="high"
            />
          </a>
          <a 
            href={getGoHref('homepage-download', 'android')}
            aria-label="Get it on Google Play"
            class="mobile-store-badge-android transform transition-transform duration-300 hover:scale-105 hover:shadow-lg rounded-lg"
          >
            <img
              src="/images/Google_Play_Badge.png"
              alt="Get it on Google Play"
              class="h-12 sm:h-14 w-auto object-contain"
              width="270"
              height="80"
            />
          </a>
        </div>
      </div>

      <div class="tb-divider max-w-4xl mx-auto border-t my-12"></div>

      <section id="features" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
        <div class="text-center mb-16">
          <h2 class="tb-text-strong text-3xl sm:text-4xl font-bold mb-4">From saved recipe to dinner</h2>
          <p class="tb-text-muted max-w-2xl mx-auto text-lg">Stop collecting recipes you never use. Save them once, find them later, then turn them into a plan and grocery list.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Feature 1 -->
          <div class="tb-card group p-8 transition-all duration-300 hover:-translate-y-1">
            <div class="tb-icon-tile w-14 h-14 rounded-[var(--tb-radius)] flex items-center justify-center mb-6 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </div>
            <h3 class="tb-text-strong text-xl font-bold mb-3">Save recipes from social media</h3>
            <p class="tb-text-muted leading-relaxed">
              Share a TikTok, Instagram, Pinterest, YouTube, or food blog recipe to TasteBuddy. Ingredients, steps, and photos become a clean recipe card.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="tb-card group p-8 transition-all duration-300 hover:-translate-y-1">
            <div class="tb-icon-tile w-14 h-14 rounded-[var(--tb-radius)] flex items-center justify-center mb-6 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="tb-text-strong text-xl font-bold mb-3">Find saved recipes again</h3>
            <p class="tb-text-muted leading-relaxed">
              Search one cookbook instead of digging through screenshots, bookmarks, browser tabs, and old social saves when dinner starts.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="tb-card group p-8 transition-all duration-300 hover:-translate-y-1">
            <div class="tb-icon-tile w-14 h-14 rounded-[var(--tb-radius)] flex items-center justify-center mb-6 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <h3 class="tb-text-strong text-xl font-bold mb-3">Plan, shop, and cook</h3>
            <p class="tb-text-muted leading-relaxed">
              Add saved recipes to your weekly meal plan, build a shopping list from the ingredients, and cook from clear step-by-step instructions.
            </p>
          </div>
        </div>
      </section>

      <!-- How It Works Section -->
      <section class="py-16 max-w-4xl mx-auto px-4">
        <h2 class="tb-text-strong text-3xl font-bold text-center mb-12">How TasteBuddy works</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="tb-step-badge rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold">1</span>
            </div>
            <h3 class="tb-text-strong text-xl font-semibold mb-3">Save the recipe</h3>
            <p class="tb-text-muted">Use a TikTok, Instagram, Pinterest, YouTube, Facebook, or website link, or import from a screenshot or note.</p>
          </div>

          <div class="text-center">
            <div class="tb-step-badge rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold">2</span>
            </div>
            <h3 class="tb-text-strong text-xl font-semibold mb-3">Get a clean recipe</h3>
            <p class="tb-text-muted">TasteBuddy extracts ingredients, steps, photos, servings, and source details into a readable recipe card.</p>
          </div>

          <div class="text-center">
            <div class="tb-step-badge rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold">3</span>
            </div>
            <h3 class="tb-text-strong text-xl font-semibold mb-3">Turn it into dinner</h3>
            <p class="tb-text-muted">Find it later, add it to a weekly meal plan, send ingredients to a shopping list, or start cooking mode.</p>
          </div>
        </div>
      </section>

      <!-- App Screenshots -->
      <div class="py-20 relative">
        <div class="app-screenshots-container">
          <div class="relative max-w-6xl mx-auto px-4">
            <div class="phone-carousel">
              <div class="screenshots-grid">
                <div class="screenshot-wrapper">
                  <Image
                    src="/images/tastebuddy-save-recipes.webp"
                    alt="TasteBuddy saves recipes from social media, websites, screenshots, and notes"
                    width={330}
                    height={717}
                    format="webp"
                    class="app-screenshot"
                  />
                </div>
                <div class="screenshot-wrapper mt-8 sm:mt-12">
                  <Image
                    src="/images/tastebuddy-recipe-details.webp"
                    alt="TasteBuddy recipe details with ingredients, steps, time, and servings"
                    width={330}
                    height={717}
                    format="webp"
                    class="app-screenshot"
                  />
                </div>
                <div class="screenshot-wrapper">
                  <Image
                    src="/images/tastebuddy-find-recipes.webp"
                    alt="Find saved recipes quickly in the TasteBuddy recipe organizer"
                    width={330}
                    height={717}
                    format="webp"
                    class="app-screenshot"
                  />
                </div>
                <div class="screenshot-wrapper mt-8 sm:mt-12">
                  <Image
                    src="/images/tastebuddy-cooking-steps.webp"
                    alt="TasteBuddy step-by-step cooking mode"
                    width={330}
                    height={717}
                    format="webp"
                    class="app-screenshot"
                  />
                </div>
                <div class="screenshot-wrapper">
                  <Image
                    src="/images/tastebuddy-meal-planning.webp"
                    alt="Build a meal plan and grocery list from saved recipes in TasteBuddy"
                    width={330}
                    height={717}
                    format="webp"
                    class="app-screenshot"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="tb-divider max-w-4xl mx-auto border-t my-12"></div>

      <section class="py-12 max-w-4xl mx-auto text-center px-4">
        <h2 class="tb-text-strong text-3xl font-bold mb-6">Built for how recipes are saved now</h2>
        <p class="tb-text-muted mx-auto max-w-3xl text-lg leading-relaxed">
          Most recipe apps were built for typed recipe cards or web bookmarks. TasteBuddy is built for the modern mess: saved Reels, TikToks, screenshots, food blogs, notes, and handwritten cards that should become recipes you can actually cook.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-12">
          <div class="tb-card p-6">
            <div class="tb-text-strong text-2xl font-bold mb-2">Social saves</div>
            <div class="tb-text-muted text-sm">TikTok, Instagram, Pinterest, YouTube, and Facebook recipe links.</div>
          </div>
          <div class="tb-card p-6">
            <div class="tb-text-strong text-2xl font-bold mb-2">Offline mess</div>
            <div class="tb-text-muted text-sm">Screenshots, handwritten recipe cards, notes, and old cookbook photos.</div>
          </div>
          <div class="tb-card p-6">
            <div class="tb-text-strong text-2xl font-bold mb-2">Dinner workflow</div>
            <div class="tb-text-muted text-sm">Search, meal planning, shopping lists, and cooking mode after import.</div>
          </div>
        </div>
      </section>

      <div class="tb-divider max-w-4xl mx-auto border-t my-12"></div>

      <!-- FAQ Section -->
      <section id="faq" class="py-12 sm:py-16 max-w-4xl mx-auto px-4 scroll-mt-24">
        <h2 class="tb-text-strong text-3xl font-bold text-center mb-12">
          Frequently Asked Questions
        </h2>
        
        <div class="grid gap-6">
          <div class="tb-card p-6">
            <h3 class="tb-text-strong text-lg font-bold mb-3 flex items-start gap-3">
              <span class="tb-accent mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
              </span>
              What is TasteBuddy?
            </h3>
            <p class="tb-text-muted ml-8 leading-relaxed">TasteBuddy is a recipe organizer and meal planning app for people who save recipes across social media, websites, screenshots, handwritten cards, and notes. It turns saved recipe ideas into a searchable cookbook, meal plan, shopping list, and cooking view.</p>
          </div>
          
          <div class="tb-card p-6">
            <h3 class="tb-text-strong text-lg font-bold mb-3 flex items-start gap-3">
              <span class="tb-accent mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
              </span>
              Can I save recipes from TikTok and Instagram?
            </h3>
            <p class="tb-text-muted ml-8 leading-relaxed">Yes. Share a TikTok, Instagram, Pinterest, YouTube, Facebook, or website recipe to TasteBuddy, or paste the link. TasteBuddy extracts the recipe into clear ingredients, steps, and photos.</p>
          </div>
          
          <div class="tb-card p-6">
            <h3 class="tb-text-strong text-lg font-bold mb-3 flex items-start gap-3">
              <span class="tb-accent mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
              </span>
              How does TasteBuddy help me cook recipes I already saved?
            </h3>
            <p class="tb-text-muted ml-8 leading-relaxed">TasteBuddy keeps your saved recipes searchable, then helps you plan meals from them, send ingredients to a shopping list, and cook from step-by-step instructions.</p>
          </div>

          <div class="tb-card p-6">
            <h3 class="tb-text-strong text-lg font-bold mb-3 flex items-start gap-3">
              <span class="tb-accent mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
              </span>
              Does TasteBuddy make shopping lists from recipes?
            </h3>
            <p class="tb-text-muted ml-8 leading-relaxed">Yes. Add saved recipes to a meal plan and use the ingredients to build a shopping list, so recipe saves become groceries you can actually buy.</p>
          </div>

          <div class="tb-card p-6">
            <h3 class="tb-text-strong text-lg font-bold mb-3 flex items-start gap-3">
              <span class="tb-accent mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
              </span>
              Is TasteBuddy a meal prep app?
            </h3>
            <p class="tb-text-muted ml-8 leading-relaxed">TasteBuddy is more flexible than a rigid meal prep app. It is built for people who save recipes all week and want an easier way to decide what to cook, shop for the ingredients, and start cooking.</p>
          </div>
        </div>
      </section>

      <div class="tb-divider max-w-4xl mx-auto border-t my-12"></div>

      <!-- Final CTA -->
      <section class="py-12">
        <div class="tb-cta-panel p-8 sm:p-12 max-w-4xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-4">Cook the recipes you already saved</h2>
          <p class="text-xl">
            Save recipes from anywhere, find them again, plan dinner, and build the shopping list in one app.
          </p>
        </div>
      </section>
    </section>
  </Main>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(mobileAppStructuredData)} />
<script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

<style>
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
  }
  
  @media (min-width: 768px) {
    .screenshots-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .screenshot-wrapper {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: var(--tb-shadow-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .screenshot-wrapper:hover {
    transform: translateY(-5px);
    box-shadow: var(--tb-shadow-md);
  }
  
  .app-screenshot {
    border-radius: 1.5rem;
    width: 100%;
    height: auto;
    display: block;
    border: 3px solid var(--tb-border);
  }
  
  @media (max-width: 640px) {
    .screenshots-grid {
      gap: 1rem;
      padding: 0.5rem;
    }
    
    .screenshot-wrapper {
      border-radius: 1rem;
    }
    
    .app-screenshot {
      border-radius: 1rem;
      border-width: 2px;
    }
  }
  
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0px);
    }
  }
  
  .phone-carousel {
    animation: float 6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-carousel {
      animation: none;
    }

    .screenshot-wrapper,
    .screenshot-wrapper:hover {
      transform: none;
      transition: none;
    }
  }
</style>
