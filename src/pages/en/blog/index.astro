---
import Layout from "../../../layouts/Layout.astro";
import Main from "../../../components/Main.astro";
import { listArticles } from '../../../lib/marketing/articles';

// Get all blog posts
const posts = await Astro.glob('./posts/*.{md,mdx}');

// Sort posts by date
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
});
const automatedArticles = listArticles('en');

// Get current path for language switcher
const { pathname } = Astro.url;
const dePath = pathname.replace("/en/", "/de/");

const description =
  "Read TasteBuddy cooking tips, recipe organization strategies, meal planning guides, and product updates.";
---

<Layout title="TasteBuddy Blog - Cooking Tips & Recipe Organization" description={description}>
  <Main>
    <!-- Language Switcher -->
    <div class="absolute top-6 right-6 z-10">
      <div class="flex gap-3 bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-2 rounded-full border border-[#2A2D24]/30 backdrop-blur-sm">
        <a href={pathname} class="px-3 py-1 rounded-full text-sm font-medium transition-colors bg-[#00CE31]/20 text-white border border-[#00CE31]/30">
          EN
        </a>
        <a href={dePath} class="px-3 py-1 rounded-full text-sm font-medium transition-colors text-gray-400 hover:text-white">
          DE
        </a>
      </div>
    </div>
    
    <section class="py-12 sm:py-16 lg:py-20">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
            TasteBuddy Blog
          </h1>
          <p class="text-xl text-gray-300 max-w-2xl mx-auto">
            Discover cooking tips, recipe organization strategies, and the latest updates from our team
          </p>
        </div>

        <!-- Featured Resources Section -->
        <div class="mb-16">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-8 text-center">Featured Resources</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Best Recipe Apps -->
            <a href="/best-all-recipe-app/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">🏆</div>
              <h3 class="text-lg font-semibold text-white mb-2">Best All Recipe App</h3>
              <p class="text-gray-400 text-sm">Find the top recipe apps with AI features, meal planning, and smart organization.</p>
            </a>

            <!-- Recipe Organization Guide -->
            <a href="/guides/how-to-organize-recipes/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">📚</div>
              <h3 class="text-lg font-semibold text-white mb-2">How to Organize Recipes</h3>
              <p class="text-gray-400 text-sm">Complete guide with tips, tools, and systems for efficient recipe management.</p>
            </a>

            <!-- TasteBuddy vs AllRecipes -->
            <a href="/comparisons/tastebuddy-vs-allrecipes/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">⚔️</div>
              <h3 class="text-lg font-semibold text-white mb-2">TasteBuddy vs AllRecipes</h3>
              <p class="text-gray-400 text-sm">See which recipe organizer app is better for meal planning and cooking features.</p>
            </a>

            <!-- Meal Planning Guide -->
            <a href="/guides/meal-planning-for-beginners/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">🗓️</div>
              <h3 class="text-lg font-semibold text-white mb-2">Meal Planning for Beginners</h3>
              <p class="text-gray-400 text-sm">Master meal planning with expert tips for budget-friendly and efficient cooking.</p>
            </a>

            <!-- Best Recipe Planner App -->
            <a href="/best-recipe-planner-app/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">📅</div>
              <h3 class="text-lg font-semibold text-white mb-2">Best Recipe Planner App</h3>
              <p class="text-gray-400 text-sm">Compare top meal planning apps and discover which features matter most.</p>
            </a>

            <!-- Recipe App Features Guide -->
            <a href="/guides/recipe-app-features/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">⚙️</div>
              <h3 class="text-lg font-semibold text-white mb-2">Essential Recipe App Features</h3>
              <p class="text-gray-400 text-sm">Learn what features to look for in modern recipe management applications.</p>
            </a>

            <!-- Shopping List Workflow -->
            <a href="/solutions/recipe-app-with-shopping-list/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">🛒</div>
              <h3 class="text-lg font-semibold text-white mb-2">Recipe App With Shopping List</h3>
              <p class="text-gray-400 text-sm">Turn saved recipes into practical grocery lists and meal plans.</p>
            </a>

            <!-- Saved Recipe Systems -->
            <a href="/solutions/organize-saved-recipes/" class="block bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 rounded-2xl border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <div class="text-2xl mb-3">📦</div>
              <h3 class="text-lg font-semibold text-white mb-2">Saved Recipe Systems</h3>
              <p class="text-gray-400 text-sm">Move recipes out of scattered saves and into one searchable library.</p>
            </a>
          </div>

          <!-- View All Resources Link -->
          <div class="text-center mt-8">
            <a href="/guides/how-to-organize-recipes/" class="inline-flex items-center text-[#00CE31] hover:text-[#00CE31]/80 font-medium">
              View All Resources
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>

        <div class="mb-16">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-8 text-center">Automation-Ready Articles</h2>
          <div class="grid gap-6">
            {automatedArticles.map((article) => (
              <a href={`/en/blog/articles/${article.slug}/`} class="block rounded-2xl border border-[#2A2D24]/30 bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 p-6 backdrop-blur-sm transition-all duration-300 hover:border-[#00CE31]/40">
                <p class="mb-3 text-sm uppercase tracking-[0.2em] text-[#8FECA8]">{article.frontmatter.template_type}</p>
                <h3 class="text-2xl font-semibold text-white mb-2">{article.frontmatter.title}</h3>
                <p class="text-gray-300">{article.frontmatter.description}</p>
              </a>
            ))}
          </div>
        </div>
        
        <div class="grid gap-8">
          {sortedPosts.map((post) => (
            <article class="bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 rounded-2xl overflow-hidden border border-[#2A2D24]/30 backdrop-blur-sm hover:border-[#2A2D24]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[#00CE31]/10">
              <a href={post.url} class="block">
                {post.frontmatter.image && (
                  <div class="relative h-64 overflow-hidden">
                    <img 
                      src={post.frontmatter.image} 
                      alt={post.frontmatter.title}
                      class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-6 sm:p-8">
                  <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3 hover:text-[#00CE31] transition-colors">
                    {post.frontmatter.title}
                  </h2>
                  <div class="flex items-center text-gray-400 text-sm mb-4">
                    <span class="inline-block">
                      {new Date(post.frontmatter.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </span>
                    {post.frontmatter.author && (
                      <>
                        <span class="mx-2">•</span>
                        <span>{post.frontmatter.author}</span>
                      </>
                    )}
                  </div>
                  <p class="text-gray-300 mb-4 line-clamp-3">
                    {post.frontmatter.description || post.frontmatter.excerpt}
                  </p>
                  <div class="flex items-center text-[#00CE31] font-medium hover:text-[#00CE31]/80 transition-colors">
                    Read more
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        {sortedPosts.length === 0 && (
          <div class="text-center py-12 bg-gradient-to-br from-[#1C2513]/90 to-[#1C2513]/80 rounded-2xl p-8 backdrop-blur-sm border border-[#2A2D24]/30">
            <div class="text-4xl mb-4">📝</div>
            <h2 class="text-2xl font-semibold text-white mb-2">No Posts Yet</h2>
            <p class="text-gray-400 text-lg">We're working on some great content. Check back soon!</p>
          </div>
        )}
      </div>
    </section>
  </Main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style> 
