---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FAB from "../components/FAB.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description?: string;
  skipDefaultStructuredData?: boolean;
  alternates?: Partial<Record<'en' | 'de' | 'x-default', string>> | null;
  robots?: string;
  hideMobileChrome?: boolean;
}

const {
  title,
  description = "Save every recipe from anywhere—screenshots, websites, handwritten cards, and social media. Keep them searchable and ready on all your devices.",
  skipDefaultStructuredData = false,
  alternates = null,
  robots = 'index, follow',
  hideMobileChrome = false,
} = Astro.props;

// Language detection and hreflang generation
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/de/') ? 'de' : currentPath.startsWith('/en/') ? 'en' : 'en';
const baseUrl = 'https://taste-buddy.app';

// Canonical URL with trailing slash normalization.
const ensureTrailingSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const canonicalPath = currentPath === '/' ? '/' : ensureTrailingSlash(currentPath);
const canonicalUrl = `${baseUrl}${canonicalPath}`;

// Generate hreflang URLs
function getHreflangUrls(path: string) {
  // Remove language prefix if it exists
  let cleanPath = path.replace(/^\/(en|de)\//, '/');
  if (cleanPath === '/') cleanPath = '';
  const withSlash = (url: string) => (url.endsWith('/') ? url : `${url}/`);
  
  return {
    en: cleanPath ? withSlash(`${baseUrl}${cleanPath}`) : `${baseUrl}/`,
    de: withSlash(`${baseUrl}/de${cleanPath}`),
    'x-default': cleanPath ? withSlash(`${baseUrl}${cleanPath}`) : `${baseUrl}/`
  };
}

const defaultAlternates =
  currentPath === '/' || currentPath === '/de/' ? getHreflangUrls(currentPath) : null;
const hreflangUrls = alternates ?? defaultAlternates;

// Open Graph locale mapping
const ogLocale = currentLang === 'de' ? 'de_DE' : 'en_US';
const ogAltLocale = currentLang === 'de' ? 'en_US' : 'de_DE';

// Organization & Website structured data
const organizationStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TasteBuddy",
  url: baseUrl,
  logo: `${baseUrl}/Icon.png`,
  sameAs: [
    "https://apps.apple.com/app/apple-store/id6554007741?pt=127208178&ct=Website&mt=8",
    "https://play.google.com/store/apps/details?id=app.tastebuddy"
  ]
};

const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: baseUrl,
  name: "TasteBuddy",
  inLanguage: currentLang
};
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light dark" />
    <meta id="tb-theme-color" name="theme-color" content="#FFFFFF" />
    <script is:inline>
      (() => {
        const storageKey = "tastebuddy-theme";
        const validModes = new Set(["system", "light", "dark"]);
        const root = document.documentElement;
        const media = window.matchMedia?.("(prefers-color-scheme: dark)");
        let mode = "system";

        try {
          const storedMode = localStorage.getItem(storageKey);
          mode = validModes.has(storedMode) ? storedMode : "system";
        } catch {
          mode = "system";
        }

        const resolvedTheme = mode === "system" ? (media?.matches ? "dark" : "light") : mode;
        root.dataset.theme = mode;
        root.dataset.resolvedTheme = resolvedTheme;
        root.style.colorScheme = resolvedTheme;

        document
          .querySelector("#tb-theme-color")
          ?.setAttribute("content", resolvedTheme === "dark" ? "#10130B" : "#FFFFFF");
      })();
    </script>
    
    <!-- Core Web Vitals Optimizations -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://apps.apple.com">
    <link rel="preconnect" href="https://play.google.com">
    
    <!-- Font loading optimization -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"></noscript>
    
    <!-- Preload critical above-the-fold images -->
    <link rel="preload" href="/Icon.png" as="image" type="image/png">
    <link rel="preload" href="/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg" as="image" type="image/svg+xml" fetchpriority="high">
    
    <!-- Social meta tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/images/tastebuddy-app-screenshots.webp`} />
    <meta name="twitter:image:alt" content="TasteBuddy app screenshots" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${baseUrl}/images/tastebuddy-app-screenshots.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />
    
    <!-- Canonical and hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    {hreflangUrls?.en && <link rel="alternate" hreflang="en" href={hreflangUrls.en} />}
    {hreflangUrls?.de && <link rel="alternate" hreflang="de" href={hreflangUrls.de} />}
    {hreflangUrls?.['x-default'] && <link rel="alternate" hreflang="x-default" href={hreflangUrls['x-default']} />}
    
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    { !skipDefaultStructuredData && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(organizationStructuredData)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />
      </>
    ) }
    <script
      is:inline
      defer
      data-website-id="dfid_HZKAHoEmczvpFfO1lSFFK"
      data-domain="taste-buddy.app"
      src="https://datafa.st/js/script.js"
    ></script>
    <script is:inline>
      (() => {
        const ua = navigator.userAgent || navigator.vendor || "";
        const platform = navigator.platform || "";
        const isAndroid = /android/i.test(ua);
        const isIOS = /iPad|iPhone|iPod/.test(ua) || (platform === "MacIntel" && navigator.maxTouchPoints > 1);

        document.documentElement.dataset.mobilePlatform = isAndroid ? "android" : isIOS ? "ios" : "fallback";
      })();
    </script>
  </head>
  <body class:list={[
    "tb-site-shell min-h-screen flex flex-col font-['Inter',sans-serif]",
    hideMobileChrome ? "pb-0" : "pb-32 md:pb-0",
  ]}>
    <Analytics />
    <div class:list={[hideMobileChrome && "hidden md:block"]}>
      <Header />
    </div>
    
    <main class="flex-grow">
      <slot />
    </main>

    <div class:list={[hideMobileChrome && "hidden md:block"]}>
      <Footer />
    </div>
    <div class:list={[hideMobileChrome && "hidden md:block"]}>
      <FAB />
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --tb-primary: #00340E;
    --tb-secondary: #00CE31;
    --tb-muted: #66685F;
    --tb-subtle: #8B9182;
    --tb-border: #DBDAD2;
    --tb-border-soft: rgba(219, 218, 210, 0.72);
    --tb-page-bg: #FFFFFF;
    --tb-page-bg-soft: #F7F4ED;
    --tb-surface: #FFFFFF;
    --tb-surface-muted: #EFEDEC;
    --tb-surface-raised: #FFFFFF;
    --tb-banner: #D7FFE0;
    --tb-text: #00340E;
    --tb-text-strong: #00340E;
    --tb-text-inverse: #FFFFFF;
    --tb-accent: #00CE31;
    --tb-accent-soft: #D7FFE0;
    --tb-accent-text: #00340E;
    --tb-button-primary: #00340E;
    --tb-button-primary-text: #FFFFFF;
    --tb-button-secondary: #00CE31;
    --tb-button-secondary-text: #F7F4ED;
    --tb-shadow-sm: 0 8px 24px rgba(0, 52, 14, 0.08);
    --tb-shadow-md: 0 18px 44px rgba(0, 52, 14, 0.11);
    --tb-shadow-accent: 0 18px 44px rgba(0, 206, 49, 0.20);
    --tb-radius: 16px;
    --tb-radius-sm: 8px;
    --tb-radius-pill: 999px;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-resolved-theme="light"]) {
      --tb-primary: #F7F4ED;
      --tb-secondary: #00CE31;
      --tb-muted: #8B9182;
      --tb-subtle: #66685F;
      --tb-border: #2B381F;
      --tb-border-soft: rgba(43, 56, 31, 0.72);
      --tb-page-bg: #10130B;
      --tb-page-bg-soft: #14180F;
      --tb-surface: #10130B;
      --tb-surface-muted: #1C2513;
      --tb-surface-raised: #1C2513;
      --tb-banner: #2B381F;
      --tb-text: #F7F4ED;
      --tb-text-strong: #FFFFFF;
      --tb-text-inverse: #10130B;
      --tb-accent: #00CE31;
      --tb-accent-soft: rgba(0, 206, 49, 0.18);
      --tb-accent-text: #8FECA8;
      --tb-button-primary: #F7F4ED;
      --tb-button-primary-text: #000000;
      --tb-button-secondary: #00CE31;
      --tb-button-secondary-text: #F7F4ED;
      --tb-shadow-sm: 0 8px 24px rgba(0, 0, 0, 0.22);
      --tb-shadow-md: 0 18px 44px rgba(0, 0, 0, 0.28);
      --tb-shadow-accent: 0 18px 44px rgba(0, 206, 49, 0.18);
    }
  }

  :root[data-resolved-theme="light"] {
    color-scheme: light;
    --tb-primary: #00340E;
    --tb-secondary: #00CE31;
    --tb-muted: #66685F;
    --tb-subtle: #8B9182;
    --tb-border: #DBDAD2;
    --tb-border-soft: rgba(219, 218, 210, 0.72);
    --tb-page-bg: #FFFFFF;
    --tb-page-bg-soft: #F7F4ED;
    --tb-surface: #FFFFFF;
    --tb-surface-muted: #EFEDEC;
    --tb-surface-raised: #FFFFFF;
    --tb-banner: #D7FFE0;
    --tb-text: #00340E;
    --tb-text-strong: #00340E;
    --tb-text-inverse: #FFFFFF;
    --tb-accent: #00CE31;
    --tb-accent-soft: #D7FFE0;
    --tb-accent-text: #00340E;
    --tb-button-primary: #00340E;
    --tb-button-primary-text: #FFFFFF;
    --tb-button-secondary: #00CE31;
    --tb-button-secondary-text: #F7F4ED;
    --tb-shadow-sm: 0 8px 24px rgba(0, 52, 14, 0.08);
    --tb-shadow-md: 0 18px 44px rgba(0, 52, 14, 0.11);
    --tb-shadow-accent: 0 18px 44px rgba(0, 206, 49, 0.20);
  }

  :root[data-resolved-theme="dark"] {
    color-scheme: dark;
    --tb-primary: #F7F4ED;
    --tb-secondary: #00CE31;
    --tb-muted: #8B9182;
    --tb-subtle: #66685F;
    --tb-border: #2B381F;
    --tb-border-soft: rgba(43, 56, 31, 0.72);
    --tb-page-bg: #10130B;
    --tb-page-bg-soft: #14180F;
    --tb-surface: #10130B;
    --tb-surface-muted: #1C2513;
    --tb-surface-raised: #1C2513;
    --tb-banner: #2B381F;
    --tb-text: #F7F4ED;
    --tb-text-strong: #FFFFFF;
    --tb-text-inverse: #10130B;
    --tb-accent: #00CE31;
    --tb-accent-soft: rgba(0, 206, 49, 0.18);
    --tb-accent-text: #8FECA8;
    --tb-button-primary: #F7F4ED;
    --tb-button-primary-text: #000000;
    --tb-button-secondary: #00CE31;
    --tb-button-secondary-text: #F7F4ED;
    --tb-shadow-sm: 0 8px 24px rgba(0, 0, 0, 0.22);
    --tb-shadow-md: 0 18px 44px rgba(0, 0, 0, 0.28);
    --tb-shadow-accent: 0 18px 44px rgba(0, 206, 49, 0.18);
  }

  html {
    background: var(--tb-page-bg);
  }

  .tb-site-shell {
    background:
      linear-gradient(180deg, var(--tb-page-bg) 0%, var(--tb-page-bg) 52%, var(--tb-page-bg-soft) 100%);
    color: var(--tb-text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  .tb-text {
    color: var(--tb-text);
  }

  .tb-text-strong {
    color: var(--tb-text-strong);
  }

  .tb-text-muted {
    color: var(--tb-muted);
  }

  .tb-text-subtle {
    color: var(--tb-subtle);
  }

  .tb-accent {
    color: var(--tb-accent-text);
  }

  .tb-link {
    color: var(--tb-accent-text);
    font-weight: 650;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .tb-link:hover {
    color: var(--tb-secondary);
  }

  .tb-panel,
  .tb-card {
    background: var(--tb-surface-raised);
    border: 1px solid var(--tb-border-soft);
    border-radius: var(--tb-radius);
    box-shadow: var(--tb-shadow-sm);
  }

  .tb-panel-muted {
    background: var(--tb-surface-muted);
    border: 1px solid var(--tb-border-soft);
    border-radius: var(--tb-radius);
  }

  .tb-pill {
    background: var(--tb-surface);
    border: 1px solid var(--tb-border);
    border-radius: var(--tb-radius-pill);
    color: var(--tb-text);
  }

  .tb-pill-active {
    background: var(--tb-primary);
    border-color: var(--tb-primary);
    color: var(--tb-text-inverse);
  }

  .tb-icon-tile,
  .tb-step-badge {
    background: var(--tb-accent-soft);
    color: var(--tb-primary);
  }

  .tb-divider {
    border-color: var(--tb-border-soft);
  }

  .tb-cta-panel {
    background: var(--tb-banner);
    border: 1px solid color-mix(in srgb, var(--tb-secondary) 28%, transparent);
    border-radius: var(--tb-radius);
    color: var(--tb-primary);
    box-shadow: var(--tb-shadow-sm);
  }

  .tb-app-surface {
    background: var(--tb-surface);
    color: var(--tb-text);
  }

  .rounded-2xl,
  .rounded-3xl {
    border-radius: var(--tb-radius) !important;
  }

  @media (prefers-color-scheme: light) {
    .text-white,
    .text-gray-100 {
      color: var(--tb-text) !important;
    }

    .text-gray-200,
    .text-gray-300 {
      color: var(--tb-muted) !important;
    }

    .text-gray-400,
    .text-gray-500 {
      color: var(--tb-subtle) !important;
    }

    [class~="text-[#00CE31]"],
    [class~="text-[#8FECA8]"] {
      color: var(--tb-accent-text) !important;
    }

    [class~="border-[#2A2D24]/20"],
    [class~="border-[#2A2D24]/30"],
    [class~="border-[#2A2D24]/40"],
    [class~="border-[#2A2D24]/50"],
    [class~="border-[#2A2D24]"] {
      border-color: var(--tb-border-soft) !important;
    }

    [class~="bg-[#10130B]"],
    [class~="bg-[#10130B]/80"],
    [class~="bg-[#10130B]/60"],
    [class~="bg-[#14180F]"],
    [class~="bg-[#14180F]/80"],
    [class~="bg-[#1C2513]"],
    [class~="bg-[#1C2513]/95"],
    [class~="bg-[#1C2513]/90"],
    [class~="bg-[#1C2513]/80"],
    [class~="bg-[#1C2513]/60"],
    [class~="bg-[#1C2513]/50"],
    [class~="bg-[#1C2513]/40"],
    [class~="bg-[#1C2513]/30"] {
      background-color: var(--tb-surface) !important;
    }

    [class*="from-[#1C2513]"] {
      --tw-gradient-from: var(--tb-surface-muted) var(--tw-gradient-from-position) !important;
      --tw-gradient-to: rgb(239 237 236 / 0) var(--tw-gradient-to-position) !important;
      --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
    }

    [class*="via-[#1C2513]"] {
      --tw-gradient-to: rgb(239 237 236 / 0) var(--tw-gradient-to-position) !important;
      --tw-gradient-stops: var(--tw-gradient-from), var(--tb-surface-muted) var(--tw-gradient-via-position), var(--tw-gradient-to) !important;
    }

    [class*="to-[#1C2513]"] {
      --tw-gradient-to: var(--tb-surface-muted) var(--tw-gradient-to-position) !important;
    }
  }

  :root[data-resolved-theme="light"] .text-white,
  :root[data-resolved-theme="light"] .text-gray-100 {
    color: var(--tb-text) !important;
  }

  :root[data-resolved-theme="light"] .text-gray-200,
  :root[data-resolved-theme="light"] .text-gray-300 {
    color: var(--tb-muted) !important;
  }

  :root[data-resolved-theme="light"] .text-gray-400,
  :root[data-resolved-theme="light"] .text-gray-500 {
    color: var(--tb-subtle) !important;
  }

  :root[data-resolved-theme="light"] [class~="text-[#00CE31]"],
  :root[data-resolved-theme="light"] [class~="text-[#8FECA8]"] {
    color: var(--tb-accent-text) !important;
  }

  :root[data-resolved-theme="light"] [class~="border-[#2A2D24]/20"],
  :root[data-resolved-theme="light"] [class~="border-[#2A2D24]/30"],
  :root[data-resolved-theme="light"] [class~="border-[#2A2D24]/40"],
  :root[data-resolved-theme="light"] [class~="border-[#2A2D24]/50"],
  :root[data-resolved-theme="light"] [class~="border-[#2A2D24]"] {
    border-color: var(--tb-border-soft) !important;
  }

  :root[data-resolved-theme="light"] [class~="bg-[#10130B]"],
  :root[data-resolved-theme="light"] [class~="bg-[#10130B]/80"],
  :root[data-resolved-theme="light"] [class~="bg-[#10130B]/60"],
  :root[data-resolved-theme="light"] [class~="bg-[#14180F]"],
  :root[data-resolved-theme="light"] [class~="bg-[#14180F]/80"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]/95"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]/90"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]/80"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]/60"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]/50"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]/40"],
  :root[data-resolved-theme="light"] [class~="bg-[#1C2513]/30"] {
    background-color: var(--tb-surface) !important;
  }

  :root[data-resolved-theme="light"] [class*="from-[#1C2513]"] {
    --tw-gradient-from: var(--tb-surface-muted) var(--tw-gradient-from-position) !important;
    --tw-gradient-to: rgb(239 237 236 / 0) var(--tw-gradient-to-position) !important;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
  }

  :root[data-resolved-theme="light"] [class*="via-[#1C2513]"] {
    --tw-gradient-to: rgb(239 237 236 / 0) var(--tw-gradient-to-position) !important;
    --tw-gradient-stops: var(--tw-gradient-from), var(--tb-surface-muted) var(--tw-gradient-via-position), var(--tw-gradient-to) !important;
  }

  :root[data-resolved-theme="light"] [class*="to-[#1C2513]"] {
    --tw-gradient-to: var(--tb-surface-muted) var(--tw-gradient-to-position) !important;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  
  ::-webkit-scrollbar-track {
    background: color-mix(in srgb, var(--tb-surface-muted) 70%, transparent);
  }
  
  ::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--tb-border) 72%, transparent);
    border-radius: 4px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: var(--tb-border);
  }
  
  /* Button styles */
  .btn-primary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: var(--tb-radius-pill);
    background: var(--tb-button-primary);
    color: var(--tb-button-primary-text) !important;
    font-weight: 750;
    line-height: 1;
    padding: 0.875rem 1.35rem;
    box-shadow: var(--tb-shadow-md);
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: var(--tb-shadow-accent);
  }
  
  .btn-secondary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--tb-border);
    border-radius: var(--tb-radius-pill);
    background: var(--tb-surface);
    color: var(--tb-text) !important;
    font-weight: 700;
    line-height: 1;
    padding: 0.875rem 1.35rem;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .btn-secondary:hover {
    transform: translateY(-1px);
    border-color: var(--tb-primary);
    background: var(--tb-surface-muted);
  }

  @media (max-width: 767px) {
    .mobile-store-badge-android {
      display: none;
    }

    html[data-mobile-platform="android"] .mobile-store-badge-ios {
      display: none;
    }

    html[data-mobile-platform="android"] .mobile-store-badge-android {
      display: inline-flex;
    }
  }
</style>
